<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:da="DuelArena.UI">
    <!-- L'interface de la partie (2026-10-12) : barre de score, vie, messages de manche, panneau de
         préparation, fondu au noir, écran de fin et son vote, salon de la partie et menu d'Échap. Pilotée
         par GameHud, LoadoutPanel, MatchEndScreen, SalonPanel, PauseMenu et OptionsController, sur /GameUI
         de MultiTestScene.
         L'ordre compte : chaque bloc se dessine par-dessus les précédents. -->
    <ui:Template name="OptionsPanel" src="../Shared/OptionsPanel.uxml" />
    <ui:Style src="../Shared/Theme.uss" />
    <ui:Style src="GameHud.uss" />

    <ui:VisualElement name="hudRoot" class="hud-root da-vars" picking-mode="Ignore">

        <!-- Barre de score : moi à gauche, l'adversaire à droite, le chrono de la manche au milieu -->
        <ui:VisualElement name="scoreBar" class="score-bar" picking-mode="Ignore">
            <ui:VisualElement class="score-side score-side--left" picking-mode="Ignore">
                <ui:Label name="leftName" class="score-name" picking-mode="Ignore" />
                <ui:VisualElement name="leftPips" class="score-pips" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="roundTimer" class="round-timer" picking-mode="Ignore" />
            <ui:VisualElement class="score-side score-side--right" picking-mode="Ignore">
                <ui:VisualElement name="rightPips" class="score-pips" picking-mode="Ignore" />
                <ui:Label name="rightName" class="score-name" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- La vie, façon Rainbow Six : le chiffre, et une jauge dont la part perdue rougit un instant -->
        <ui:VisualElement name="healthPanel" class="health-panel" picking-mode="Ignore">
            <ui:VisualElement class="health-row" picking-mode="Ignore">
                <ui:Label name="healthValue" class="health-value" picking-mode="Ignore" />
                <ui:Label class="health-unit" text="PV" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="health-bar" picking-mode="Ignore">
                <ui:VisualElement name="healthTrail" class="health-trail" picking-mode="Ignore" />
                <ui:VisualElement name="healthFill" class="health-fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Décompte, fin de manche, attente -->
        <ui:VisualElement name="centerMessage" class="center-message" picking-mode="Ignore">
            <ui:Label name="centerBig" class="center-big" picking-mode="Ignore" />
            <ui:Label name="centerSmall" class="center-small" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- La tribune (2026-10-13, piloté par SpectatorHud) : l'invite de la touche F (un spectateur
             ramasse, un duelliste prend une arme lancée), l'élan d'un lancer, le panneau du spectateur
             (sa place dans la file, ce qu'il tient, ses commandes) et l'étourdissement. -->
        <ui:Label name="interactPrompt" class="interact-prompt hidden" picking-mode="Ignore" />
        <ui:VisualElement name="chargeBar" class="charge-bar hidden" picking-mode="Ignore">
            <ui:VisualElement name="chargeFill" class="charge-fill" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="spectatorPanel" class="spectator-panel hidden" picking-mode="Ignore">
            <ui:Label name="spectatorRole" class="spectator-role" picking-mode="Ignore" />
            <ui:Label name="spectatorCarry" class="spectator-carry" picking-mode="Ignore" />
            <ui:Label name="spectatorHints" class="spectator-hints" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="stunOverlay" class="stun-overlay hidden" picking-mode="Ignore">
            <ui:Label name="stunLabel" class="stun-label" text="ÉTOURDI" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Préparation : le choix de l'arme avant la manche -->
        <ui:VisualElement name="loadoutPanel" class="loadout-panel hidden">
            <ui:VisualElement class="loadout-header">
                <ui:Label name="loadoutTitle" class="loadout-title" text="Choisis ton arme" />
                <ui:Label name="loadoutTimer" class="loadout-timer" />
            </ui:VisualElement>
            <ui:Label name="loadoutRound" class="loadout-round" />
            <ui:VisualElement name="loadoutCards" class="loadout-cards" />
            <ui:VisualElement class="loadout-footer">
                <ui:Label name="loadoutStatus" class="loadout-status" />
                <ui:Button name="loadoutValidate" class="menu-button menu-button--primary loadout-validate" text="Valider (Entrée)" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Écran de fin de match : la colonne de gauche est vide, le robot du gagnant y célèbre
             dans l'arène (VictoryStage, caméra plein écran derrière l'interface) -->
        <ui:VisualElement name="endScreen" class="end-screen hidden" picking-mode="Ignore">
            <ui:VisualElement class="end-portrait-column" picking-mode="Ignore" />
            <ui:VisualElement class="end-results-column">
                <ui:Label name="endTitle" class="end-title" />
                <ui:Label name="endSubtitle" class="end-subtitle" />
                <ui:VisualElement name="scoreTable" class="score-table" />
                <!-- Le vote des deux duellistes (2026-10-26) : la revanche demande leurs deux voix -->
                <ui:VisualElement name="endVote" class="end-vote">
                    <ui:VisualElement name="endVoteStatus" class="end-vote-status" />
                    <ui:VisualElement name="endVoteButtons" class="end-vote-buttons">
                        <ui:Button name="endRematchButton" class="menu-button menu-button--primary end-vote-button" text="Revanche" />
                        <ui:Button name="endSalonButton" class="menu-button end-vote-button" text="Retour au salon" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="end-footer">
                    <ui:Label name="endCountdown" class="end-countdown" />
                    <ui:Button name="endQuitButton" class="menu-button end-quit" text="Quitter la partie" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Le salon de la partie (2026-10-26) : après un match sans revanche. L'hôte règle et relance,
             les autres l'attendent. -->
        <ui:VisualElement name="salonPanel" class="salon-panel hidden">
            <ui:VisualElement class="salon-header">
                <ui:Label class="salon-title" text="SALON" />
                <ui:Label name="salonMode" class="salon-mode" />
            </ui:VisualElement>
            <ui:VisualElement class="salon-body">
                <ui:VisualElement class="salon-column">
                    <ui:Label class="salon-section" text="JOUEURS" />
                    <ui:VisualElement name="salonPlayers" class="salon-players" />
                </ui:VisualElement>
                <ui:VisualElement class="salon-column">
                    <ui:Label class="salon-section" text="RÉGLAGES" />
                    <ui:VisualElement class="salon-rule">
                        <ui:Label class="salon-rule__label" text="MANCHES" />
                        <da:OptionCycler name="salonRoundsCycler" class="salon-rule__cycler" choices-text="BO5 · premier à 3;BO3 · premier à 2" loop="true" />
                    </ui:VisualElement>
                    <ui:VisualElement class="salon-rule">
                        <ui:Label class="salon-rule__label" text="PLACES" />
                        <da:OptionCycler name="salonCapacityCycler" class="salon-rule__cycler" />
                    </ui:VisualElement>
                    <ui:VisualElement class="salon-rule">
                        <ui:Label class="salon-rule__label" text="DUELS" />
                        <da:OptionCycler name="salonOrganizationCycler" class="salon-rule__cycler" choices-text="Roi de la colline;Duellistes fixes" loop="true" />
                    </ui:VisualElement>
                    <ui:VisualElement class="salon-rule">
                        <ui:Label class="salon-rule__label" text="INTERVENTIONS" />
                        <da:OptionCycler name="salonInterventionsCycler" class="salon-rule__cycler" choices-text="Non;Oui" loop="true" />
                    </ui:VisualElement>
                    <ui:Label name="salonRulesHint" class="salon-hint" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="salonInvite" class="salon-invite" />
            <ui:VisualElement class="salon-footer">
                <ui:Label name="salonStatus" class="salon-status" />
                <ui:VisualElement class="salon-buttons">
                    <ui:Button name="salonQuitButton" class="menu-button salon-button" text="Quitter la partie" />
                    <ui:Button name="salonLaunchButton" class="menu-button menu-button--primary salon-button" text="Lancer la partie" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Fondu au noir entre deux manches (GDD § 5), et autour de l'écran de fin : il couvre
             tout sauf le menu d'Échap -->
        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore" />

        <!-- Menu d'Échap : reprendre, options, quitter la partie -->
        <ui:VisualElement name="pauseRoot" class="pause-root hidden">
            <ui:VisualElement name="pauseMain" class="screen">
                <ui:Label class="pause-title" text="PAUSE" />
                <ui:Label name="pauseInviteLabel" class="pause-invite hidden" text="" />
                <ui:Button name="pauseResumeButton" class="menu-button menu-button--primary" text="Reprendre" />
                <ui:Button name="pauseOptionsButton" class="menu-button" text="Options" />
                <ui:Button name="pauseQuitButton" class="menu-button menu-button--quit" text="Quitter la partie" />
                <ui:Label class="pause-hint" text="La partie continue pendant que ce menu est ouvert." />
            </ui:VisualElement>
            <ui:VisualElement name="pauseOptions" class="pause-options hidden">
                <ui:Instance template="OptionsPanel" class="options-instance" />
                <ui:Button name="pauseOptionsBackButton" class="back-button" text="Retour" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
