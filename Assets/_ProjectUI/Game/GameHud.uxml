<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:da="DuelArena.UI">
    <!-- L'interface de la partie (2026-10-12) : barre de score, vie, messages de manche, panneau de
         préparation, fondu au noir, écran de fin et son vote, salon de la partie et menu d'Échap. Pilotée
         par GameHud, LoadoutPanel, MatchEndScreen, SalonPanel, PauseMenu et OptionsController, sur /GameUI
         de MultiTestScene.
         L'ordre compte : chaque bloc se dessine par-dessus les précédents. -->
    <ui:Template name="OptionsPanel" src="../Shared/OptionsPanel.uxml" />
    <ui:Template name="SalonView" src="../Shared/SalonView.uxml" />
    <ui:Style src="../Shared/Theme.uss" />
    <ui:Style src="GameHud.uss" />

    <ui:VisualElement name="hudRoot" class="hud-root da-vars" picking-mode="Ignore">

        <!-- Touché par un caillou (2026-10-27, piloté par HitIndicatorHud) : la zone rouge autour du réticule,
             tournée vers le lanceur, et les arcs électriques au bord de l'écran, du même côté. Sous le reste du
             HUD : le score et la vie restent lisibles. -->
        <da:HitIndicatorOverlay name="hitIndicator" class="hit-indicator hidden" picking-mode="Ignore" />

        <!-- La Zone (2026-11-02) : ses repères à l'écran, la zone du moment et la suivante, avec leur distance. -->
        <ui:VisualElement name="zoneMarker" class="zone-marker hidden" picking-mode="Ignore">
            <ui:VisualElement name="zoneMarkerHalo" class="zone-marker__halo" picking-mode="Ignore" />
            <ui:VisualElement name="zoneMarkerIcon" class="zone-marker__icon" picking-mode="Ignore" />
            <ui:Label name="zoneMarkerLabel" class="zone-marker__label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="nextZoneMarker" class="zone-marker zone-marker--next hidden" picking-mode="Ignore">
            <ui:VisualElement name="nextZoneMarkerHalo" class="zone-marker__halo" picking-mode="Ignore" />
            <ui:VisualElement name="nextZoneMarkerIcon" class="zone-marker__icon" picking-mode="Ignore" />
            <ui:Label name="nextZoneMarkerLabel" class="zone-marker__label" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Barre de score : moi à gauche, l'adversaire à droite, le chrono de la manche au milieu. Au Gun Game
             (2026-11-02), l'échelle de chacun à la place des manches, et l'arme de sa marche. -->
        <ui:VisualElement name="scoreBar" class="score-bar" picking-mode="Ignore">
            <ui:VisualElement class="score-side score-side--left" picking-mode="Ignore">
                <ui:Label name="leftWeapon" class="score-weapon hidden" picking-mode="Ignore" />
                <ui:Label name="leftName" class="score-name" picking-mode="Ignore" />
                <ui:Label name="leftPoints" class="score-points hidden" picking-mode="Ignore" />
                <ui:VisualElement name="leftGauge" class="score-gauge hidden" picking-mode="Ignore">
                    <ui:VisualElement name="leftGaugeFill" class="score-gauge__fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="leftPips" class="score-pips" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="roundTimer" class="round-timer" picking-mode="Ignore" />
            <ui:VisualElement class="score-side score-side--right" picking-mode="Ignore">
                <ui:VisualElement name="rightPips" class="score-pips" picking-mode="Ignore" />
                <ui:VisualElement name="rightGauge" class="score-gauge score-gauge--mirror hidden" picking-mode="Ignore">
                    <ui:VisualElement name="rightGaugeFill" class="score-gauge__fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="rightPoints" class="score-points hidden" picking-mode="Ignore" />
                <ui:Label name="rightName" class="score-name" picking-mode="Ignore" />
                <ui:Label name="rightWeapon" class="score-weapon hidden" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- La Zone : le compte à atteindre, qui la tient, et quand elle bouge -->
        <ui:Label name="scoreGoal" class="score-goal hidden" picking-mode="Ignore" />
        <ui:Label name="zoneStatus" class="zone-status hidden" picking-mode="Ignore" />

        <!-- La vie, façon Rainbow Six : le chiffre, et une jauge dont la part perdue rougit un instant -->
        <ui:VisualElement name="healthPanel" class="health-panel" picking-mode="Ignore">
            <ui:VisualElement class="health-row" picking-mode="Ignore">
                <ui:Label name="healthValue" class="health-value" picking-mode="Ignore" />
                <ui:Label class="health-unit" text="PV" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="health-bar" picking-mode="Ignore">
                <ui:VisualElement name="healthTrail" class="health-trail" picking-mode="Ignore" />
                <ui:VisualElement name="healthFill" class="health-fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Décompte, fin de manche, attente -->
        <ui:VisualElement name="centerMessage" class="center-message" picking-mode="Ignore">
            <ui:Label name="centerBig" class="center-big" picking-mode="Ignore" />
            <ui:Label name="centerSmall" class="center-small" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Le Tournoi (2026-11-03, piloté par TournamentBoard) : dans la salle d'attente, où en est le tournoi, ce qui
             attend le joueur, le classement de la poule et les matchs du tour (en cours, ou à venir). -->
        <ui:VisualElement name="tournamentBoard" class="tournament-board hidden" picking-mode="Ignore">
            <ui:Label class="tournament-board__title" text="TOURNOI" picking-mode="Ignore" />
            <ui:Label name="tournamentStage" class="tournament-board__stage" picking-mode="Ignore" />
            <ui:Label name="tournamentMine" class="tournament-board__mine" picking-mode="Ignore" />
            <ui:Label class="tournament-board__heading" text="CLASSEMENT" picking-mode="Ignore" />
            <ui:VisualElement name="tournamentStandings" class="tournament-board__rows" picking-mode="Ignore" />
            <ui:Label name="tournamentMatchesHeading" class="tournament-board__heading" picking-mode="Ignore" />
            <ui:VisualElement name="tournamentMatches" class="tournament-board__rows" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- La tribune (2026-10-13, piloté par SpectatorHud) : l'invite de la touche F (un spectateur
             ramasse, un duelliste prend une arme lancée), le panneau du spectateur (sa place dans la file,
             ce qu'il tient, ses commandes) et l'étourdissement. Un lancer visé montre sa trajectoire dans
             le monde (ThrowArcPreview, 2026-10-27), plus de jauge d'élan. -->
        <ui:Label name="interactPrompt" class="interact-prompt hidden" picking-mode="Ignore" />
        <ui:VisualElement name="spectatorPanel" class="spectator-panel hidden" picking-mode="Ignore">
            <ui:Label name="spectatorRole" class="spectator-role" picking-mode="Ignore" />
            <ui:Label name="spectatorCarry" class="spectator-carry" picking-mode="Ignore" />
            <ui:Label name="spectatorHints" class="spectator-hints" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="stunOverlay" class="stun-overlay hidden" picking-mode="Ignore">
            <ui:Label name="stunLabel" class="stun-label" text="ÉTOURDI" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Préparation : le choix de l'arme avant la manche -->
        <ui:VisualElement name="loadoutPanel" class="loadout-panel hidden">
            <ui:VisualElement class="loadout-header">
                <ui:Label name="loadoutTitle" class="loadout-title" text="Choisis ton arme" />
                <ui:Label name="loadoutTimer" class="loadout-timer" />
            </ui:VisualElement>
            <ui:Label name="loadoutRound" class="loadout-round" />
            <!-- Pile ou face (2026-11-03) : la pièce, qui choisit la famille, et ses boutons pour celui qui choisit. -->
            <ui:Label name="loadoutCoin" class="loadout-coin hidden" />
            <ui:VisualElement name="loadoutFamilies" class="loadout-families hidden" />
            <ui:VisualElement name="loadoutCards" class="loadout-cards" />
            <ui:VisualElement class="loadout-footer">
                <ui:Label name="loadoutStatus" class="loadout-status" />
                <ui:Button name="loadoutValidate" class="menu-button menu-button--primary loadout-validate" text="Valider (Entrée)" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Écran de fin de match : la colonne de gauche est vide, le robot du gagnant y célèbre
             dans l'arène (VictoryStage, caméra plein écran derrière l'interface) -->
        <ui:VisualElement name="endScreen" class="end-screen hidden" picking-mode="Ignore">
            <ui:VisualElement class="end-portrait-column" picking-mode="Ignore" />
            <ui:VisualElement class="end-results-column">
                <ui:Label name="endTitle" class="end-title" />
                <ui:Label name="endSubtitle" class="end-subtitle" />
                <ui:VisualElement name="scoreTable" class="score-table" />
                <!-- Le vote des deux duellistes (2026-10-26) : la revanche demande leurs deux voix -->
                <ui:VisualElement name="endVote" class="end-vote">
                    <ui:VisualElement name="endVoteStatus" class="end-vote-status" />
                    <ui:VisualElement name="endVoteButtons" class="end-vote-buttons">
                        <ui:Button name="endRematchButton" class="menu-button menu-button--primary end-vote-button" text="Revanche" />
                        <ui:Button name="endSalonButton" class="menu-button end-vote-button" text="Retour au salon" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="end-footer">
                    <ui:Label name="endCountdown" class="end-countdown" />
                    <ui:Button name="endQuitButton" class="menu-button end-quit" text="Quitter la partie" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Le salon de la partie (2026-10-26) : après un match sans revanche. L'hôte règle et relance, les
             autres l'attendent. Depuis le 2026-11-02, le gabarit du salon du menu (SalonView, maquette « B ·
             Salon »), en plein écran par-dessus l'arène, piloté par SalonPanel. -->
        <ui:VisualElement name="salonPanel" class="salon-panel hidden">
            <da:SlantBox class="salon-panel__frame" picking-mode="Ignore" />
            <ui:Instance template="SalonView" />
        </ui:VisualElement>

        <!-- La légende de la kill cam (2026-11-04, pilotée par GameHud d'après KillCam), en bas à gauche : qui, avec
             quoi, où, de combien. -->
        <ui:VisualElement name="killCamCaption" class="kill-cam-caption hidden" picking-mode="Ignore">
            <ui:Label name="killCamTitle" class="kill-cam-caption__title" text="LE COUP MORTEL" picking-mode="Ignore" />
            <ui:Label name="killCamLine" class="kill-cam-caption__line" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Fondu au noir entre deux manches (GDD § 5), et autour de l'écran de fin : il couvre
             tout sauf le menu d'Échap. À l'arrivée dans l'arène (2026-11-03), il porte l'écran de chargement, le même
             que celui du menu (Theme.uss), jusqu'à ce que la partie soit prête. -->
        <ui:VisualElement name="fade" class="fade" picking-mode="Ignore">
            <ui:VisualElement name="loadingBlock" class="loading-block hidden" picking-mode="Ignore">
                <da:ArenaLogo class="loading-block__logo" picking-mode="Ignore" />
                <ui:Label name="loadingTitle" class="loading-block__title" text="CHARGEMENT" picking-mode="Ignore" />
                <da:Spinner class="loading-block__spinner" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Menu d'Échap : reprendre, options, quitter la partie -->
        <ui:VisualElement name="pauseRoot" class="pause-root hidden">
            <ui:VisualElement name="pauseMain" class="screen">
                <ui:Label class="pause-title" text="PAUSE" />
                <ui:Label name="pauseInviteLabel" class="pause-invite hidden" text="" />
                <ui:Button name="pauseResumeButton" class="menu-button menu-button--primary" text="Reprendre" />
                <ui:Button name="pauseOptionsButton" class="menu-button" text="Options" />
                <ui:Button name="pauseQuitButton" class="menu-button menu-button--quit" text="Quitter la partie" />
                <ui:Label class="pause-hint" text="La partie continue pendant que ce menu est ouvert." />
            </ui:VisualElement>
            <ui:VisualElement name="pauseOptions" class="pause-options hidden">
                <ui:Instance template="OptionsPanel" class="options-instance" />
                <ui:Button name="pauseOptionsBackButton" class="back-button" text="Retour" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
