/* L'interface de la partie (2026-10-12). Les boutons, panneaux et options viennent de
   MainMenu.uss : un seul style pour le menu et la partie. */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hidden {
    display: none;
}

/* -------------------- Barre de score -------------------- */

.score-bar {
    position: absolute;
    top: 18px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.score-side {
    flex-direction: row;
    align-items: center;
    width: 420px;
}

.score-side--left {
    justify-content: flex-end;
}

.score-side--right {
    justify-content: flex-start;
}

.score-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 242, 245);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
    margin-left: 12px;
    margin-right: 12px;
}

.score-pips {
    flex-direction: row;
    align-items: center;
}

.score-pip {
    width: 16px;
    height: 16px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.75);
    background-color: rgba(0, 0, 0, 0.35);
}

.score-pip--won {
    background-color: rgb(70, 210, 110);
    border-color: rgb(70, 210, 110);
}

.score-pip--lost {
    background-color: rgb(230, 70, 70);
    border-color: rgb(230, 70, 70);
}

/* Le Gun Game (2026-11-02) : une marche par arme de l'échelle, le gant au bout. Les marches passées se
   remplissent ; celle où l'on est se cerne de blanc. */
.score-pip--step {
    width: 10px;
    height: 18px;
    margin-left: 2px;
    margin-right: 2px;
    border-radius: 2px;
}

.score-pip--glove {
    width: 18px;
    border-radius: 9px;
}

/* À droite, l'échelle monte aussi vers le chrono : le gant au milieu de la barre. */
.score-pips--mirror {
    flex-direction: row-reverse;
}

.score-pip--current {
    border-color: rgb(255, 255, 255);
    border-width: 3px;
}

.score-weapon {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(214, 218, 224);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
    margin-left: 4px;
    margin-right: 4px;
}

.round-timer {
    width: 110px;
    margin-left: 8px;
    margin-right: 8px;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 242, 245);
    background-color: rgba(10, 13, 17, 0.55);
    border-radius: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
}

/* -------------------- Vie (façon Rainbow Six) -------------------- */

/* Un fond sombre : le chiffre blanc reste lisible sur le sol clair de l'arène. */
.health-panel {
    position: absolute;
    left: 28px;
    bottom: 24px;
    width: 360px;
    padding: 6px 12px 12px 12px;
    background-color: rgba(10, 13, 17, 0.5);
    border-radius: 6px;
}

.health-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 4px;
}

.health-value {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(240, 242, 245);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
    padding: 0;
    margin: 0;
}

.health-unit {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgba(240, 242, 245, 0.8);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
    margin-left: 8px;
    margin-bottom: 9px;
    padding: 0;
}

.health-bar {
    height: 12px;
    background-color: rgba(10, 13, 17, 0.6);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    border-radius: 2px;
    overflow: hidden;
}

.health-trail {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(230, 60, 50);
}

.health-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(240, 242, 245);
}

.health-panel--low .health-value {
    color: rgb(255, 110, 90);
}

.health-panel--low .health-fill {
    background-color: rgb(255, 110, 90);
}

/* -------------------- Messages au centre -------------------- */

.center-message {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    align-items: center;
}

.center-big {
    font-size: 96px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.75);
}

.center-big--sentence {
    font-size: 54px;
}

.center-small {
    margin-top: 8px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(230, 233, 237);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.75);
}

/* -------------------- Préparation -------------------- */

.loadout-panel {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1060px;
    translate: -50% -50%;
    background-color: rgba(18, 22, 28, 0.94);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 26px;
}

.loadout-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.loadout-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(240, 242, 245);
}

.loadout-timer {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 106, 19);
}

.loadout-round {
    font-size: 14px;
    color: rgb(150, 158, 168);
    letter-spacing: 1px;
    margin-bottom: 16px;
}

/* Pile ou face (2026-11-03) : la pièce et qui choisit, puis les familles à choisir. */
.loadout-coin {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(244, 190, 28);
    margin-bottom: 12px;
    white-space: normal;
}

.loadout-families {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.loadout-family-choice {
    margin: 0 10px 8px 0;
    min-width: 180px;
}

/* Une arme hors de la famille de la manche : éteinte, plus qu'une carte qu'on ne peut plus choisir (:disabled, 0,55),
   qui l'emportait sur une seule classe. */
.loadout-card.loadout-card--outside,
.loadout-card.loadout-card--outside:disabled {
    opacity: 0.25;
}

.loadout-cards {
    flex-direction: row;
    justify-content: space-between;
}

.loadout-card {
    width: 200px;
    height: 150px;
    margin: 0;
    padding: 12px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    transition-duration: 0.1s;
}

.loadout-card:hover {
    border-color: rgba(255, 106, 19, 0.6);
}

.loadout-card--active {
    border-color: rgb(255, 106, 19);
    background-color: rgba(255, 106, 19, 0.16);
}

.loadout-card:disabled {
    opacity: 0.55;
}

.loadout-card Label {
    -unity-text-align: upper-left;
}

.loadout-card-key {
    font-size: 13px;
    color: rgb(255, 106, 19);
    -unity-font-style: bold;
}

.loadout-card-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 242, 245);
    margin-top: 6px;
    white-space: normal;
}

/* Les douze armes (2026-10-26) : une colonne par famille, trois cartes. Provisoire : le panneau aux
   favorites viendra avec l'interface de la refonte. */
.loadout-family {
    flex-direction: column;
}

.loadout-family__title {
    font-size: 13px;
    color: rgb(255, 106, 19);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 6px;
}

/* Le nom, et l'arme de profil à côté (2026-10-27, WeaponPortraits) : rien d'autre, demandé par l'utilisateur. */
.loadout-family > .loadout-card {
    width: 240px;
    height: 72px;
    margin-bottom: 8px;
    padding: 8px 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

/* Le nom tient sur une ligne ; le portrait prend la place qui reste (« FAP-03 » passait à la ligne). */
.loadout-family > .loadout-card > .loadout-card-name {
    margin-top: 0;
    white-space: nowrap;
    flex-shrink: 0;
}

.loadout-card__portrait {
    width: 128px;
    height: 48px;
    flex-shrink: 1;
    margin-left: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.loadout-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 18px;
}

.loadout-status {
    font-size: 15px;
    color: rgb(200, 205, 212);
    flex-shrink: 1;
    white-space: normal;
}

.loadout-status--ready {
    color: rgb(120, 220, 140);
}

.loadout-validate {
    width: 260px;
    margin-top: 0;
}

/* -------------------- Fondu au noir -------------------- */

/* -------------------- Le replay du coup mortel (2026-11-03) -------------------- */

.replay-frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.replay-frame__band {
    position: absolute;
    left: 0;
    right: 0;
    height: 9%;
    background-color: rgb(0, 0, 0);
}

.replay-frame__band--top {
    top: 0;
}

.replay-frame__band--bottom {
    bottom: 0;
}

.replay-caption {
    position: absolute;
    left: 56px;
    bottom: 12%;
    padding: 8px 18px 10px 16px;
    background-color: rgba(10, 13, 17, 0.62);
    border-left-width: 4px;
    border-left-color: rgb(244, 190, 28);
}

.replay-caption__title {
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(244, 190, 28);
}

.replay-caption__line {
    margin-top: 2px;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(232, 236, 240);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

.fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

/* -------------------- Écran de fin -------------------- */

.end-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    padding: 48px;
}

/* Vide : le robot du gagnant y célèbre, dans l'arène, derrière l'interface. */
.end-portrait-column {
    width: 40%;
    height: 100%;
}

.end-results-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 48px;
    justify-content: center;
    background-color: rgba(8, 10, 13, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 28px 32px;
}

.end-title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(255, 106, 19);
    white-space: normal;
}

.end-subtitle {
    font-size: 24px;
    color: rgb(200, 205, 212);
    margin-top: 6px;
    margin-bottom: 30px;
}

.score-table {
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px 0;
}

.score-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 18px;
}

.score-row--header {
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.score-row--winner {
    background-color: rgba(255, 106, 19, 0.12);
}

.score-cell {
    width: 120px;
    font-size: 18px;
    color: rgb(230, 233, 237);
    -unity-text-align: middle-center;
}

.score-cell--name {
    width: 220px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
}

.score-row--header .score-cell {
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(150, 158, 168);
    -unity-font-style: normal;
}

.end-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 30px;
}

.end-countdown {
    font-size: 16px;
    color: rgb(170, 177, 186);
}

.end-quit {
    width: 260px;
    margin-top: 0;
}

/* -------------------- Menu d'Échap -------------------- */

.pause-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 13, 17, 0.78);
}

.pause-title {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 8px;
    margin-bottom: 18px;
    -unity-text-align: upper-center;
}

.pause-hint {
    margin-top: 18px;
    font-size: 13px;
    color: rgb(150, 158, 168);
    -unity-text-align: upper-center;
}

/* Le code de la partie en ligne, à donner à qui veut venir (2026-10-13) */
.pause-invite {
    margin-bottom: 14px;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(255, 106, 19);
    -unity-text-align: upper-center;
}

/* -------------------- La tribune (2026-10-13) -------------------- */

/* Les manches d'un duelliste, vues de la tribune : ni vertes ni rouges, on n'est d'aucun camp. */
.score-pip--neutral {
    background-color: rgb(240, 242, 245);
    border-color: rgb(240, 242, 245);
}

/* L'invite de la touche F, sous le réticule : là où se trouve le regard. */
.interact-prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: 56%;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

/* Le panneau du spectateur, en bas au centre. */
.spectator-panel {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 640px;
    margin-left: -320px;
    padding: 8px 14px 10px 14px;
    background-color: rgba(10, 13, 17, 0.5);
    border-radius: 6px;
    align-items: center;
}

.spectator-role {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(255, 160, 90);
    -unity-text-align: middle-center;
}

.spectator-carry {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 242, 245);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

.spectator-hints {
    margin-top: 2px;
    font-size: 14px;
    color: rgba(230, 233, 237, 0.85);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Étourdi : l'écran se voile, le mot clignote (SpectatorHud règle l'opacité). */
.stun-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(40, 60, 120, 0.28);
    align-items: center;
    justify-content: center;
}

.hit-indicator {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.stun-label {
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: rgb(180, 210, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
}

/* Les Options dans le menu d'Échap (2026-10-17) : le panneau partagé, plus large que les boutons du menu. */
.pause-options {
    width: 1300px;
    max-width: 94%;
}

.pause-options > .options-instance {
    width: auto;
    max-width: none;
}

/* -------------------- Vote de fin de match (2026-10-26) -------------------- */

.end-vote {
    margin-top: 24px;
}

.end-vote-status {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.end-vote-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 18px;
    padding: 6px 12px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 6px;
}

.end-vote-chip__name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(232, 236, 240);
    margin: 0 10px 0 0;
    padding: 0;
}

.end-vote-chip__choice {
    font-size: 15px;
    color: rgb(150, 160, 172);
    margin: 0;
    padding: 0;
}

.end-vote-chip--rematch {
    border-color: rgba(120, 220, 140, 0.7);
}

.end-vote-chip--rematch > .end-vote-chip__choice {
    color: rgb(140, 230, 160);
}

.end-vote-chip--salon {
    border-color: rgba(255, 200, 80, 0.7);
}

.end-vote-chip--salon > .end-vote-chip__choice {
    color: rgb(255, 210, 110);
}

.end-vote-buttons {
    flex-direction: row;
}

.end-vote-button {
    width: 260px;
    margin-top: 0;
    margin-right: 14px;
}

.end-vote-button--chosen {
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

/* -------------------- Salon de la partie (2026-10-26) --------------------
   Depuis le 2026-11-02, le gabarit partagé avec le menu (Shared/SalonView.uxml et .uss) : ici, son cadre en
   plein écran, aux marges des écrans du menu, sur l'arène assombrie. */

.salon-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 34px 58px 24px 58px;
    background-color: rgba(7, 10, 14, 0.9);
}

.salon-panel__frame {
    position: absolute;
    left: 20px;
    top: 20px;
    right: 20px;
    bottom: 20px;
    --edge-color: rgba(150, 170, 190, 0.16);
    --edge-width: 1;
    --cut-tl: 28;
    --cut-br: 28;
    --bracket-color: rgba(244, 190, 28, 0.7);
    --bracket-size: 26;
    --bracket-width: 2;
    --bracket-corners: 10;
}

/* La Zone (2026-11-02) : les points de chacun à côté de son nom, l'état de la zone sous la barre de score, et ses
   repères à l'écran (posés par GameHud, centrés sur leur point). */
.score-points {
    min-width: 70px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 242, 245);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
    margin-left: 4px;
    margin-right: 4px;
}

.zone-status {
    position: absolute;
    top: 66px;
    left: 0;
    right: 0;
    -unity-text-align: upper-center;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(240, 242, 245);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.75);
}

.zone-marker {
    position: absolute;
    translate: -50% -50%;
    padding: 2px 8px;
    background-color: rgba(10, 13, 17, 0.55);
    border-left-width: 3px;
    border-left-color: rgba(240, 242, 245, 0.9);
}

.zone-marker--next {
    opacity: 0.75;
}

.zone-marker__label {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(240, 242, 245);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
}

/* ---------- Le Tournoi (2026-11-03) : le tableau de la salle d'attente, en haut à droite ---------- */

.tournament-board {
    position: absolute;
    top: 18px;
    right: 28px;
    width: 400px;
    padding: 10px 14px 12px 14px;
    background-color: rgba(10, 13, 17, 0.62);
    border-left-width: 3px;
    border-left-color: rgb(244, 190, 28);
    border-radius: 4px;
}

.tournament-board__title {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(244, 190, 28);
}

.tournament-board__stage {
    margin-top: 2px;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(240, 242, 245);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

.tournament-board__mine {
    margin-top: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(244, 190, 28);
    white-space: normal;
}

.tournament-board__heading {
    margin-top: 10px;
    margin-bottom: 2px;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(143, 155, 168);
}

.tournament-board__rows {
    flex-direction: column;
}

.tournament-row,
.tournament-match {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding-left: 4px;
    padding-right: 4px;
}

.tournament-row--me,
.tournament-match--mine {
    background-color: rgba(244, 190, 28, 0.12);
}

.tournament-row--left {
    opacity: 0.45;
}

.tournament-row__rank {
    width: 22px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(143, 155, 168);
}

.tournament-row__name {
    flex-grow: 1;
    font-size: 15px;
    -unity-font-style: bold;
    overflow: hidden;
}

.tournament-row__record {
    width: 92px;
    font-size: 14px;
    color: rgb(232, 236, 240);
    -unity-text-align: middle-right;
}

.tournament-row__diff {
    width: 40px;
    font-size: 14px;
    color: rgb(143, 155, 168);
    -unity-text-align: middle-right;
}

.tournament-match__name {
    width: 128px;
    font-size: 14px;
    -unity-font-style: bold;
    overflow: hidden;
}

.tournament-match__name--right {
    -unity-text-align: middle-right;
}

.tournament-match__score {
    width: 56px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 242, 245);
    -unity-text-align: middle-center;
}

.tournament-match__where {
    flex-grow: 1;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(143, 155, 168);
    -unity-text-align: middle-right;
}
