<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:da="DuelArena.UI">
    <!-- Le menu principal, refait le 2026-10-17 d'après les maquettes de l'utilisateur (jaune de crash-test sur
         acier sombre). Les écrans se montrent par la classe « hidden » (MainMenuController) ; ce qui dépend
         des données (cartes des modes, joueurs du salon, tuiles, armes, accessoires) est créé par les
         contrôleurs, qui retrouvent leurs éléments par nom. -->
    <ui:Template name="OptionsPanel" src="../Shared/OptionsPanel.uxml" />
    <ui:Template name="PlayerCard" src="../Shared/PlayerCard.uxml" />
    <ui:Style src="../Shared/Theme.uss" />
    <ui:Style src="MainMenu.uss" />
    <ui:VisualElement name="root" class="root da-vars da-font" picking-mode="Position">

        <!-- Le fond : l'arène vue de la tribune (MenuArtwork, cuite par l'outil de capture), assombrie à
             gauche sous le menu de l'écran titre, et voilée sur les autres écrans. -->
        <ui:VisualElement name="backdrop" class="backdrop" picking-mode="Ignore" />
        <da:GradientFill class="backdrop-shade-left" />
        <da:GradientFill class="backdrop-shade-bottom" />
        <ui:VisualElement name="backdropDim" class="backdrop-dim hidden" picking-mode="Ignore" />

        <!-- ================= Écran titre ================= -->
        <ui:VisualElement name="screenTitle" class="title-screen">
            <ui:VisualElement class="title-left">
                <ui:VisualElement class="title-logo-block">
                    <da:ArenaLogo class="title-logo" />
                    <ui:VisualElement class="title-wordmark">
                        <ui:Label class="title-word" text="DUEL" />
                        <ui:Label class="title-word" text="ARENA" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="title-menu">
                    <ui:Button name="playButton" class="da-btn da-btn--primary title-btn title-btn--primary ui-confirm" focusable="false">
                        <da:SlantBox class="slant-bg" />
                        <ui:VisualElement class="title-btn__bar" picking-mode="Ignore" />
                        <ui:VisualElement class="da-btn__icon ico-play" picking-mode="Ignore" />
                        <ui:Label class="da-btn__label" text="JOUER" picking-mode="Ignore" />
                        <ui:VisualElement class="title-btn__chevron ico-chevron-right" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="armoryButton" class="da-btn title-btn" focusable="false">
                        <da:SlantBox class="slant-bg" />
                        <ui:VisualElement class="da-btn__icon ico-wrench" picking-mode="Ignore" />
                        <ui:Label class="da-btn__label" text="PERSONNALISATION" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="optionsButton" class="da-btn title-btn" focusable="false">
                        <da:SlantBox class="slant-bg" />
                        <ui:VisualElement class="da-btn__icon ico-gear" picking-mode="Ignore" />
                        <ui:Label class="da-btn__label" text="OPTIONS" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="quitButton" class="da-btn title-btn ui-back" focusable="false">
                        <da:SlantBox class="slant-bg" />
                        <ui:VisualElement class="da-btn__icon ico-exit" picking-mode="Ignore" />
                        <ui:Label class="da-btn__label" text="QUITTER" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="title-spacer" />

                <ui:VisualElement class="title-tagline">
                    <ui:Label class="title-tagline__accent" text="DES ROBOTS." />
                    <ui:Label class="title-tagline__accent" text="DES DUELS." />
                    <ui:Label class="title-tagline__plain" text="PAS DE RÈGLES." />
                </ui:VisualElement>
                <ui:VisualElement class="title-rule" />
                <ui:VisualElement class="title-version">
                    <da:ArenaLogo class="title-version__logo" />
                    <ui:VisualElement>
                        <ui:Label class="title-version__name" text="DUEL ARENA" />
                        <ui:Label name="versionLabel" class="title-version__number" text="v0.0.0" />
                    </ui:VisualElement>
                    <ui:Label class="title-version__mark" text="/" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="title-right">
                <ui:Instance template="PlayerCard" />
                <ui:VisualElement class="title-spacer" />
                <da:SlantBox class="title-slogan">
                    <ui:Label class="title-slogan__mark" text="//" />
                    <ui:Label class="title-slogan__text" text="UN LIEU. DES ROBOTS. UN SEUL VAINQUEUR." />
                </da:SlantBox>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= Jouer : les modes, les salons, l'entraînement ================= -->
        <ui:VisualElement name="screenPlay" class="da-screen hidden">
            <da:SlantBox class="da-frame" />
            <ui:VisualElement class="da-header">
                <ui:VisualElement class="da-brand">
                    <da:ArenaLogo class="da-brand__logo" />
                    <ui:Label class="da-brand__name" text="DUEL ARENA" />
                </ui:VisualElement>
                <ui:VisualElement class="da-tabs">
                    <ui:Button name="playTabModes" class="da-tab da-tab--active" text="MODES DE JEU" focusable="false" />
                    <ui:Button name="playTabLobbies" class="da-tab" text="SALONS" focusable="false" />
                    <ui:Button name="playTabTraining" class="da-tab" text="ENTRAÎNEMENT" focusable="false" />
                    <ui:Button name="playTabRanking" class="da-tab" focusable="false">
                        <ui:Label class="da-tab__label" text="CLASSEMENT" picking-mode="Ignore" />
                        <ui:VisualElement class="da-tab__lock" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="da-header__spacer" />
                <ui:Instance template="PlayerCard" />
            </ui:VisualElement>

            <ui:VisualElement class="play-body">
                <ui:VisualElement class="play-main">
                    <!-- Les modes de jeu (GameModeCatalog) : 3 × 3 cartes, créées par PlayScreenController -->
                    <ui:VisualElement name="playPageModes" class="play-page">
                        <ui:VisualElement name="modeGrid" class="card-grid" />
                    </ui:VisualElement>

                    <!-- Les salons : rejoindre par le code, ou le réseau local sans code -->
                    <ui:VisualElement name="playPageLobbies" class="play-page hidden">
                        <da:SlantBox class="da-panel lobbies-panel">
                            <ui:Label class="da-section" text="REJOINDRE UN SALON" />
                            <ui:Label class="da-text lobbies-text" text="Tape le code que l'hôte t'a donné : tu arrives dans son salon, ou directement dans l'arène si la partie est déjà lancée." />
                            <ui:VisualElement class="join-row">
                                <ui:TextField name="joinCodeField" class="da-field join-code-field" max-length="16" />
                                <ui:Button name="joinCodeButton" class="da-btn da-btn--primary join-button ui-confirm" focusable="false">
                                    <da:SlantBox class="slant-bg" />
                                    <ui:Label class="da-btn__label" text="REJOINDRE" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </da:SlantBox>

                        <!-- Sans les services en ligne : sur le même réseau, par l'adresse de l'hôte. Sert aussi
                             au banc de test à deux instances (CLAUDE.md). -->
                        <da:SlantBox class="da-panel lobbies-panel lobbies-panel--last">
                            <ui:Label class="da-section" text="RÉSEAU LOCAL, SANS CODE" />
                            <ui:Label class="da-hint lobbies-text" text="Sur le même réseau, par l'adresse de l'hôte : pour jouer sans internet. Les réglages sont ceux de ta dernière partie créée." />
                            <ui:VisualElement class="lan-split">
                                <ui:VisualElement class="lan-column">
                                    <ui:Label class="lan-label" text="HÉBERGER · PORT D'ÉCOUTE" />
                                    <ui:TextField name="hostPortField" class="da-field" value="7777" max-length="5" />
                                    <ui:Button name="hostButton" class="da-btn lan-button" focusable="false">
                                        <da:SlantBox class="slant-bg" />
                                        <ui:Label class="da-btn__label" text="HÉBERGER" picking-mode="Ignore" />
                                    </ui:Button>
                                    <ui:Label name="lanRulesLabel" class="da-hint lan-note" text="" />
                                    <ui:Label name="localIpLabel" class="da-hint lan-note" text="" />
                                </ui:VisualElement>
                                <ui:VisualElement class="lan-column lan-column--last">
                                    <ui:Label class="lan-label" text="REJOINDRE · ADRESSE ET PORT" />
                                    <ui:VisualElement class="lan-address-row">
                                        <ui:TextField name="joinIpField" class="da-field lan-ip-field" value="127.0.0.1" />
                                        <ui:TextField name="joinPortField" class="da-field lan-port-field" value="7777" max-length="5" />
                                    </ui:VisualElement>
                                    <ui:Button name="joinButton" class="da-btn lan-button" focusable="false">
                                        <da:SlantBox class="slant-bg" />
                                        <ui:Label name="joinButtonLabel" class="da-btn__label" text="REJOINDRE" picking-mode="Ignore" />
                                    </ui:Button>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </da:SlantBox>
                    </ui:VisualElement>

                    <!-- L'entraînement : le stand de tir et la Fosse (ShootingRange) -->
                    <ui:VisualElement name="playPageTraining" class="play-page hidden">
                        <ui:VisualElement name="trainingGrid" class="card-grid" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Le détail de ce qui est choisi, et son action -->
                <da:SlantBox class="da-panel play-detail">
                    <ui:VisualElement class="play-detail__head">
                        <ui:VisualElement name="playDetailIcon" class="da-icon play-detail__icon" />
                        <ui:Label name="playDetailTitle" class="da-title" text="" />
                    </ui:VisualElement>
                    <ui:Label name="playDetailText" class="da-text play-detail__text" text="" />
                    <ui:VisualElement name="playDetailImage" class="play-detail__image" />
                    <ui:VisualElement name="playDetailFacts" class="play-detail__facts" />
                    <ui:VisualElement class="play-detail__spacer" />
                    <ui:Label name="playStatusLabel" class="da-status play-detail__status" text="" />
                    <ui:Button name="playDetailButton" class="da-btn da-btn--primary play-detail__button ui-confirm" focusable="false">
                        <da:SlantBox class="slant-bg" />
                        <ui:Label name="playDetailButtonLabel" class="da-btn__label" text="CRÉER UNE PARTIE" picking-mode="Ignore" />
                    </ui:Button>
                </da:SlantBox>
            </ui:VisualElement>

            <ui:VisualElement class="da-footer">
                <ui:Button name="playBackButton" class="key-hint ui-back" focusable="false">
                    <ui:Label class="key-hint__cap" text="ÉCHAP" picking-mode="Ignore" />
                    <ui:Label class="key-hint__label" text="RETOUR" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= Salon : les duellistes, les spectateurs, l'arène et les réglages ================= -->
        <ui:VisualElement name="screenLobby" class="da-screen hidden">
            <da:SlantBox class="da-frame" />
            <ui:VisualElement class="da-header">
                <ui:VisualElement class="da-brand">
                    <da:ArenaLogo class="da-brand__logo" />
                    <ui:Label class="da-brand__name" text="DUEL ARENA" />
                </ui:VisualElement>
                <ui:VisualElement class="lobby-headline-block">
                    <da:Spinner name="lobbySpinner" class="lobby-spinner" />
                    <ui:VisualElement>
                        <ui:Label name="lobbyHeadline" class="lobby-headline" text="MATCH EN ATTENTE" />
                        <ui:Label name="lobbySubline" class="lobby-subline" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="da-header__spacer" />
                <ui:Instance template="PlayerCard" />
            </ui:VisualElement>

            <ui:VisualElement class="lobby-body">
                <ui:VisualElement class="lobby-main">
                    <!-- Les deux duellistes en tête d'affiche, quand on sait qui ils seront -->
                    <ui:VisualElement class="lobby-versus">
                        <da:SlantBox name="duelistCard0" class="duelist-card">
                            <ui:VisualElement name="duelistPortrait0" class="duelist-card__portrait" />
                            <ui:Label name="duelistUnknown0" class="duelist-card__unknown hidden" text="?" />
                            <ui:VisualElement class="duelist-card__info">
                                <ui:Label name="duelistRole0" class="duelist-card__role" text="" />
                                <ui:Label name="duelistName0" class="duelist-card__name" text="" />
                                <ui:Label name="duelistStatus0" class="duelist-card__status" text="" />
                            </ui:VisualElement>
                        </da:SlantBox>
                        <ui:Label class="lobby-vs" text="VS" />
                        <da:SlantBox name="duelistCard1" class="duelist-card">
                            <ui:VisualElement name="duelistPortrait1" class="duelist-card__portrait" />
                            <ui:Label name="duelistUnknown1" class="duelist-card__unknown hidden" text="?" />
                            <ui:VisualElement class="duelist-card__info">
                                <ui:Label name="duelistRole1" class="duelist-card__role" text="" />
                                <ui:Label name="duelistName1" class="duelist-card__name" text="" />
                                <ui:Label name="duelistStatus1" class="duelist-card__status" text="" />
                            </ui:VisualElement>
                        </da:SlantBox>
                    </ui:VisualElement>

                    <!-- Dessous, la tribune : ceux qui attendent leur tour, et les places libres -->
                    <ui:VisualElement class="lobby-queue-header">
                        <ui:Label name="lobbyQueueTitle" class="da-section lobby-queue-title" text="SPECTATEURS" />
                        <ui:Label name="lobbyQueueHint" class="da-hint lobby-queue-hint" text="" />
                    </ui:VisualElement>
                    <ui:ScrollView name="lobbyQueueList" class="lobby-queue" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" />
                </ui:VisualElement>

                <!-- À droite, l'arène et ses éléments clés, puis les réglages de la partie -->
                <da:SlantBox class="da-panel lobby-side">
                    <ui:VisualElement class="lobby-arena-row">
                        <ui:Label class="lobby-arena-caption" text="ARÈNE :" />
                        <ui:Label name="lobbyArenaName" class="lobby-arena-name" text="" />
                    </ui:VisualElement>
                    <da:ArenaMapView name="lobbyMap" class="lobby-map" />
                    <ui:VisualElement name="lobbyMapLegend" class="map-legend" />
                    <ui:VisualElement class="lobby-rules">
                        <ui:VisualElement class="lobby-rule">
                            <ui:Label class="lobby-rule__label" text="MODE" />
                            <ui:Label name="lobbyModeValue" class="lobby-rule__value" text="" />
                        </ui:VisualElement>
                        <ui:VisualElement class="lobby-rule">
                            <ui:Label class="lobby-rule__label" text="MANCHES" />
                            <da:OptionCycler name="lobbyRoundsCycler" class="lobby-rule__cycler" choices-text="BO5 · premier à 3;BO3 · premier à 2" loop="true" />
                        </ui:VisualElement>
                        <ui:VisualElement class="lobby-rule">
                            <ui:Label class="lobby-rule__label" text="PLACES" />
                            <da:OptionCycler name="lobbyCapacityCycler" class="lobby-rule__cycler" />
                        </ui:VisualElement>
                        <!-- Ce qui se dit oui ou non : des cases à cocher (2026-10-27) -->
                        <ui:VisualElement class="lobby-rule">
                            <ui:Label class="lobby-rule__label" text="ROI DE LA COLLINE" />
                            <ui:VisualElement class="lobby-rule__check-cell">
                                <ui:Toggle name="lobbyKingToggle" class="da-check" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="lobby-rule">
                            <ui:Label class="lobby-rule__label" text="INTERVENTIONS" />
                            <ui:VisualElement class="lobby-rule__check-cell">
                                <ui:Toggle name="lobbyInterventionsToggle" class="da-check" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="lobby-rule lobby-rule--last">
                            <ui:Label class="lobby-rule__label" text="DUELLISTES ALÉATOIRES" />
                            <ui:VisualElement class="lobby-rule__check-cell">
                                <ui:Toggle name="lobbyRandomToggle" class="da-check" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="lobbyRulesHint" class="da-hint lobby-rules-hint" text="" />
                    <ui:VisualElement class="lobby-code-block">
                        <ui:VisualElement class="lobby-code-text">
                            <ui:Label class="lobby-code-caption" text="CODE DU SALON" />
                            <ui:Label name="lobbyCodeLabel" class="lobby-code" text="······" />
                        </ui:VisualElement>
                        <ui:Button name="lobbyCopyButton" class="da-btn lobby-copy" focusable="false">
                            <da:SlantBox class="slant-bg" />
                            <ui:VisualElement class="da-btn__icon ico-copy" picking-mode="Ignore" />
                            <ui:Label name="lobbyCopyLabel" class="da-btn__label" text="COPIER" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </da:SlantBox>
            </ui:VisualElement>

            <ui:VisualElement class="da-footer">
                <ui:Button name="lobbyLeaveButton" class="da-btn lobby-leave ui-back" focusable="false">
                    <da:SlantBox class="slant-bg" />
                    <ui:VisualElement class="da-btn__icon ico-exit" picking-mode="Ignore" />
                    <ui:Label class="da-btn__label" text="QUITTER LE SALON" picking-mode="Ignore" />
                </ui:Button>
                <ui:VisualElement class="da-footer__spacer" />
                <ui:Label name="lobbyStatusLabel" class="da-status lobby-status" text="" />
                <ui:Button name="lobbyStartButton" class="da-btn da-btn--primary lobby-start ui-confirm" focusable="false">
                    <da:SlantBox class="slant-bg" />
                    <ui:VisualElement class="da-btn__icon ico-play" picking-mode="Ignore" />
                    <ui:Label class="da-btn__label" text="LANCER LA PARTIE" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= Personnalisation : le robot et les armes ================= -->
        <ui:VisualElement name="screenCustomize" class="da-screen hidden">
            <da:SlantBox class="da-frame" />
            <ui:VisualElement class="da-header">
                <ui:VisualElement class="da-brand">
                    <da:ArenaLogo class="da-brand__logo" />
                    <ui:Label class="da-brand__name" text="DUEL ARENA" />
                </ui:VisualElement>
                <ui:VisualElement class="da-tabs">
                    <ui:Button name="customTabRobot" class="da-tab da-tab--active" text="ROBOT" focusable="false" />
                    <ui:Button name="customTabWeapons" class="da-tab" text="ARMES" focusable="false" />
                </ui:VisualElement>
                <ui:VisualElement class="da-header__spacer" />
                <ui:Instance template="PlayerCard" />
            </ui:VisualElement>

            <!-- ROBOT : ses rubriques, le robot qui tourne, les choix de la rubrique ouverte -->
            <ui:VisualElement name="customPageRobot" class="custom-body">
                <ui:VisualElement name="robotCategories" class="side-list" />
                <ui:VisualElement class="custom-stage">
                    <ui:Image name="characterPreviewImage" class="custom-stage__view" />
                    <ui:Label class="custom-stage__hint" text="Glisse sur le robot pour le faire tourner" />
                </ui:VisualElement>
                <da:SlantBox class="da-panel custom-side">
                    <ui:Label name="robotGridTitle" class="da-section" text="" />
                    <ui:VisualElement name="robotGrid" class="robot-grid" />
                    <ui:VisualElement class="custom-side__spacer" />
                    <ui:VisualElement class="robot-info">
                        <ui:Label name="robotInfoName" class="robot-info__name" text="" />
                        <ui:Label name="robotInfoTitle" class="robot-info__title" text="" />
                        <ui:Label name="robotInfoText" class="robot-info__text" text="" />
                    </ui:VisualElement>
                </da:SlantBox>
            </ui:VisualElement>

            <!-- ARMES : la panoplie, l'arme en grand et ses emplacements, sa fiche -->
            <ui:VisualElement name="customPageWeapons" class="custom-body hidden">
                <ui:VisualElement name="weaponList" class="side-list" />
                <ui:VisualElement class="custom-stage">
                    <ui:Image name="gunsmithPreview" class="custom-stage__view" />
                    <ui:Label class="custom-stage__hint custom-stage__hint--top" text="Glisse sur l'arme pour la faire tourner" />
                    <ui:VisualElement class="weapon-bottom">
                        <da:SlantBox name="slotStrip" class="slot-strip hidden">
                            <ui:VisualElement class="slot-strip__header">
                                <ui:Label name="slotStripTitle" class="da-section slot-strip__title" text="" />
                                <ui:Label name="slotStripCount" class="da-hint" text="" />
                            </ui:VisualElement>
                            <ui:VisualElement class="slot-strip__row">
                                <ui:Button name="slotStripPrev" class="strip-arrow" focusable="false">
                                    <ui:VisualElement class="strip-arrow__icon ico-chevron-left" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:ScrollView name="slotStripScroll" class="slot-strip__scroll" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
                                <ui:Button name="slotStripNext" class="strip-arrow" focusable="false">
                                    <ui:VisualElement class="strip-arrow__icon ico-chevron-right" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </da:SlantBox>
                        <ui:VisualElement name="slotRow" class="slot-row" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <da:SlantBox class="da-panel custom-side">
                    <ui:VisualElement class="weapon-head">
                        <ui:Label name="weaponModelLabel" class="weapon-head__model" text="" />
                        <ui:Label name="weaponClassLabel" class="weapon-head__class" text="" />
                    </ui:VisualElement>
                    <ui:Label name="weaponDescription" class="da-hint weapon-description" text="" />
                    <ui:VisualElement class="weapon-stats-head">
                        <ui:Label class="da-section weapon-stats-title" text="CARACTÉRISTIQUES" />
                        <ui:Label name="gunsmithStatsLegend" class="weapon-stats-legend" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement name="gunsmithStatRows" class="stat-rows" />
                    <ui:VisualElement name="gunsmithInfoGrid" class="info-grid" />
                    <ui:VisualElement class="custom-side__spacer" />
                    <ui:VisualElement class="ai-box">
                        <ui:Label name="gunsmithAiHeader" class="ai-box__header" text="" />
                        <ui:Label name="gunsmithAiText" class="ai-box__text" text="" />
                    </ui:VisualElement>
                </da:SlantBox>
            </ui:VisualElement>

            <ui:VisualElement class="da-footer">
                <ui:Button name="customBackButton" class="key-hint ui-back" focusable="false">
                    <ui:Label class="key-hint__cap" text="ÉCHAP" picking-mode="Ignore" />
                    <ui:Label class="key-hint__label" text="RETOUR" picking-mode="Ignore" />
                </ui:Button>
                <ui:VisualElement name="customHintsRobot" class="footer-hints">
                    <ui:VisualElement class="key-hint">
                        <ui:Label class="key-hint__cap" text="GLISSER" />
                        <ui:Label class="key-hint__label" text="TOURNER LE ROBOT" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="customHintsWeapons" class="footer-hints hidden">
                    <ui:VisualElement class="key-hint">
                        <ui:Label class="key-hint__cap" text="1 – 4" />
                        <ui:Label class="key-hint__label" text="ARME" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-hint">
                        <ui:Label class="key-hint__cap" text="↑ ↓" />
                        <ui:Label class="key-hint__label" text="EMPLACEMENT" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-hint">
                        <ui:Label class="key-hint__cap" text="← →" />
                        <ui:Label class="key-hint__label" text="PRÉVISUALISER" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-hint">
                        <ui:Label class="key-hint__cap" text="F" />
                        <ui:Label class="key-hint__label" text="ÉQUIPER (OU CLIC)" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= Options (panneau partagé avec le menu d'Échap) ================= -->
        <ui:VisualElement name="screenOptions" class="da-screen options-screen hidden">
            <da:SlantBox class="da-frame" />
            <ui:Instance template="OptionsPanel" class="options-instance" />
            <ui:VisualElement class="da-footer">
                <ui:Button name="optionsBackButton" class="key-hint ui-back" focusable="false">
                    <ui:Label class="key-hint__cap" text="ÉCHAP" picking-mode="Ignore" />
                    <ui:Label class="key-hint__label" text="RETOUR" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label class="da-hint options-note" text="Les réglages changés valent une fois appliqués." />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= Fenêtre : quitter le jeu ================= -->
        <ui:VisualElement name="quitModal" class="modal-overlay hidden">
            <da:SlantBox class="modal">
                <da:ArenaLogo class="modal__logo" />
                <ui:Label class="modal__title" text="QUITTER LE JEU ?" />
                <ui:Label class="modal__text" text="Tu es sûr de vouloir quitter Duel Arena ?" />
                <ui:VisualElement class="modal__buttons">
                    <ui:Button name="quitCancelButton" class="da-btn ui-back" focusable="false">
                        <da:SlantBox class="slant-bg" />
                        <ui:Label class="da-btn__label" text="ANNULER" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:VisualElement class="modal__gap" />
                    <ui:Button name="quitConfirmButton" class="da-btn da-btn--primary ui-confirm" focusable="false">
                        <da:SlantBox class="slant-bg" />
                        <ui:Label class="da-btn__label" text="QUITTER" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </da:SlantBox>
            <ui:Button name="quitBackHint" class="key-hint modal-back ui-back" focusable="false">
                <ui:Label class="key-hint__cap" text="ÉCHAP" picking-mode="Ignore" />
                <ui:Label class="key-hint__label" text="RETOUR" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>

        <!-- ================= Fenêtre : le pseudo (la carte du joueur) ================= -->
        <ui:VisualElement name="pseudoModal" class="modal-overlay hidden">
            <da:SlantBox class="modal">
                <da:ArenaLogo name="pseudoModalLogo" class="modal__logo" />
                <ui:Label class="modal__title" text="TON PSEUDO" />
                <ui:TextField name="pseudoField" class="da-field modal__field" max-length="16" />
                <ui:Label class="da-hint modal__hint" text="Vu par les autres joueurs : au score, dans le salon et sur l'écran de fin. 16 caractères au plus ; sans pseudo, « Joueur 1 », « Joueur 2 »…" />
                <ui:VisualElement class="modal__buttons">
                    <ui:Button name="pseudoOkButton" class="da-btn da-btn--primary ui-confirm" focusable="false">
                        <da:SlantBox class="slant-bg" />
                        <ui:Label class="da-btn__label" text="VALIDER" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </da:SlantBox>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
