<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="OptionsPanel" src="../Shared/OptionsPanel.uxml" />
    <ui:Style src="MainMenu.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Position">

        <!-- ================= Écran titre ================= -->
        <ui:VisualElement name="screenTitle" class="screen">
            <ui:Label name="gameTitle" class="game-title" text="DUEL ARENA" />
            <ui:Label name="gameSubtitle" class="game-subtitle" text="DUEL 1V1 — ROBOTS DE COMBAT" />
            <ui:Button name="playButton" class="menu-button menu-button--primary" text="Jouer" />
            <ui:Button name="armoryButton" class="menu-button" text="Personnalisation" />
            <ui:Button name="optionsButton" class="menu-button" text="Options" />
            <ui:Button name="quitButton" class="menu-button menu-button--quit" text="Quitter" />
        </ui:VisualElement>

        <!-- ================= Jouer : créer une partie, ou la rejoindre par son code ================= -->
        <ui:VisualElement name="screenPlay" class="screen screen--wide hidden">
            <ui:VisualElement class="panel">
                <ui:VisualElement class="pseudo-row">
                    <ui:Label class="pseudo-label" text="PSEUDO" />
                    <ui:TextField name="pseudoField" class="text-field pseudo-field" max-length="16" />
                    <ui:Label class="pseudo-hint" text="Vu par les autres joueurs. Vide : « Joueur 1 », « Joueur 2 »…" />
                </ui:VisualElement>

                <ui:VisualElement class="play-split">
                    <ui:VisualElement class="play-card">
                        <ui:Label class="section-label section-label--accent" text="CRÉER UNE PARTIE" />
                        <ui:Label class="play-card-text" text="Ouvre un salon privé et reçois un code à donner à tes amis. Le mode et les réglages se choisissent dans le salon, puis tu lances la partie." />
                        <ui:Button name="createButton" class="menu-button menu-button--primary play-card-button" text="Créer une partie" />
                    </ui:VisualElement>

                    <ui:VisualElement class="play-card play-card--last">
                        <ui:Label class="section-label section-label--accent" text="REJOINDRE UNE PARTIE" />
                        <ui:Label class="play-card-text" text="Tape le code que l'hôte t'a donné : tu arrives dans son salon, ou directement dans l'arène si la partie est lancée." />
                        <ui:TextField name="joinCodeField" class="text-field code-field" max-length="16" />
                        <ui:Button name="joinCodeButton" class="menu-button menu-button--primary play-card-button" text="Rejoindre" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="playStatusLabel" class="status-label" text="" />

                <!-- Sans les services en ligne : sur le même réseau, par l'adresse de l'hôte. Sert aussi
                     au banc de test à deux instances (CLAUDE.md). Les réglages sont ceux de la dernière
                     partie créée. -->
                <ui:Foldout name="lanFoldout" class="lan-foldout" text="Réseau local, sans code" value="false">
                    <ui:VisualElement class="host-join-split">
                        <ui:VisualElement class="host-join-column">
                            <ui:Label class="section-label" text="HÉBERGER SUR CE RÉSEAU" />
                            <ui:Label class="field-label" text="Port d'écoute" />
                            <ui:TextField name="hostPortField" class="text-field" value="7777" max-length="5" />
                            <ui:Label name="lanRulesLabel" class="rule-hint" text="" />
                            <ui:Button name="hostButton" class="menu-button" text="Héberger" />
                            <ui:Label name="localIpLabel" class="local-ip-label" text="" />
                        </ui:VisualElement>

                        <ui:VisualElement class="host-join-column host-join-column--last">
                            <ui:Label class="section-label" text="REJOINDRE UNE ADRESSE" />
                            <ui:Label class="field-label" text="Adresse IP de l'hôte" />
                            <ui:TextField name="joinIpField" class="text-field" value="127.0.0.1" />
                            <ui:Label class="field-label" text="Port" />
                            <ui:TextField name="joinPortField" class="text-field" value="7777" max-length="5" />
                            <ui:Button name="joinButton" class="menu-button" text="Rejoindre" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:Foldout>
            </ui:VisualElement>
            <ui:Button name="playBackButton" class="back-button" text="Retour" />
        </ui:VisualElement>

        <!-- ================= Salon : le code, les joueurs, le mode et les réglages ================= -->
        <ui:VisualElement name="screenLobby" class="screen screen--wide hidden">
            <ui:VisualElement class="panel">
                <ui:VisualElement class="lobby-header">
                    <ui:VisualElement class="lobby-title-block">
                        <ui:Label class="panel-title lobby-title" text="Salon privé" />
                        <ui:Label name="lobbyRoleLabel" class="lobby-role" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lobby-code-block">
                        <ui:Label class="section-label lobby-code-caption" text="CODE DE LA PARTIE" />
                        <ui:VisualElement class="row">
                            <ui:Label name="lobbyCodeLabel" class="lobby-code" text="······" />
                            <ui:Button name="lobbyCopyButton" class="rule-chip lobby-copy" text="Copier" />
                        </ui:VisualElement>
                        <ui:Label class="rule-hint lobby-code-hint" text="Tes amis le tapent dans Jouer, Rejoindre une partie." />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="lobby-split">
                    <ui:VisualElement class="lobby-column">
                        <ui:Label name="lobbyPlayersTitle" class="section-label lobby-section-first" text="JOUEURS" />
                        <ui:VisualElement name="lobbyPlayerList" class="lobby-player-list" />
                        <ui:Label class="rule-hint" text="Les deux premiers arrivés se battent ; les autres attendent leur tour sur la tribune." />
                    </ui:VisualElement>

                    <ui:VisualElement class="lobby-column lobby-column--last">
                        <ui:Label class="section-label lobby-section-first" text="MODE" />
                        <ui:VisualElement name="lobbyModeRow" class="rule-row" />
                        <ui:Label class="section-label" text="PLACES (AU-DELÀ DE 2 : SPECTATEURS)" />
                        <ui:VisualElement name="lobbyCapacityRow" class="rule-row" />
                        <ui:Label class="section-label" text="ORGANISATION DES DUELS" />
                        <ui:VisualElement name="lobbyOrganizationRow" class="rule-row" />
                        <ui:Toggle name="lobbyInterventionsToggle" class="rule-toggle" label="Les spectateurs interviennent (cailloux, matériel, bagarre)" />
                        <ui:Label name="lobbyRulesHint" class="rule-hint" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="lobby-footer">
                    <ui:Label name="lobbyStatusLabel" class="status-label lobby-status" text="" />
                    <ui:Button name="lobbyStartButton" class="menu-button menu-button--primary lobby-start" text="Lancer la partie" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="lobbyLeaveButton" class="back-button" text="Quitter le salon" />
        </ui:VisualElement>

        <!-- ================= Personnalisation ================= -->
        <ui:VisualElement name="screenArmory" class="screen screen--wide hidden">
            <ui:VisualElement class="panel">
                <ui:Label class="panel-title" text="Personnalisation" />

                <ui:VisualElement class="armory-layout">
                    <ui:VisualElement class="viewport-column">
                        <ui:Image name="characterPreviewImage" class="preview-viewport" />
                        <ui:Label class="preview-hint" text="Glisse pour faire tourner" />
                    </ui:VisualElement>

                    <ui:VisualElement class="armory-controls-column">
                        <ui:Label class="section-label" text="COULEUR SOUHAITÉE" />
                        <ui:VisualElement name="colorSwatchRow" class="wrap-row" />
                        <ui:Label class="hint-text" text="Dans le prototype, le serveur attribue encore seul la couleur de chaque robot (la première libre de la palette). Ton choix sera pris en compte une fois la personnalisation branchée au serveur." />

                        <ui:Label class="section-label" text="ARME DE DÉPART" />
                        <ui:VisualElement name="weaponCardRow" class="wrap-row" />
                        <ui:Label class="hint-text" text="L'arme choisie ici est celle que tu as en main à l'arrivée. En partie, chaque joueur choisit son arme avant chaque manche, pendant la préparation (clic ou touches 1 à 4) ; une fois la manche lancée, on la garde." />

                        <ui:Button name="openWeaponCustomizeButton" class="menu-button" text="Personnaliser les armes →" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="armoryBackButton" class="back-button" text="Retour" />
        </ui:VisualElement>

        <!-- ================= Armurerie avancée (accessoires) ================= -->
        <ui:VisualElement name="screenWeaponCustomize" class="screen screen--wide hidden">
            <ui:VisualElement class="panel">
                <ui:Label class="panel-title" text="Armurerie avancée" />

                <ui:VisualElement name="weaponSwitchRow" class="wrap-row weapon-switch-row" />

                <ui:VisualElement class="viewport-column viewport-column--centered">
                    <ui:Image name="weaponPreviewImage" class="preview-viewport preview-viewport--wide" />
                    <ui:Label name="weaponCustomizeName" class="weapon-customize-name" text="" />
                    <ui:Label class="preview-hint" text="Glisse pour faire tourner" />
                </ui:VisualElement>

                <ui:VisualElement name="categoryTabRow" class="tab-row" />
                <ui:VisualElement name="weaponOptionRow" class="wrap-row" />

                <ui:Label class="hint-text" text="Le modèle et la finition se voient en match, par tous les joueurs, et ne changent rien à l'arme. Les accessoires, eux, la changent (recul, épaulement, chargeur) ; tous sont ouverts à tous. Aucun ne touche aux dégâts : c'est la classe de l'arme qui les fait." />
            </ui:VisualElement>
            <ui:Button name="weaponCustomizeBackButton" class="back-button" text="Retour" />
        </ui:VisualElement>

        <!-- ================= Options (panneau partagé avec le menu d'Échap) ================= -->
        <ui:VisualElement name="screenOptions" class="screen hidden">
            <ui:Instance template="OptionsPanel" class="options-instance" />
            <ui:Button name="optionsBackButton" class="back-button" text="Retour" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
