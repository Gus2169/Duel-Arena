<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="OptionsPanel" src="../Shared/OptionsPanel.uxml" />
    <ui:Style src="MainMenu.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Position">

        <!-- ================= Écran titre ================= -->
        <ui:VisualElement name="screenTitle" class="screen">
            <ui:Label name="gameTitle" class="game-title" text="DUEL ARENA" />
            <ui:Label name="gameSubtitle" class="game-subtitle" text="DUEL 1V1 — ROBOTS DE COMBAT" />
            <ui:Button name="playButton" class="menu-button menu-button--primary" text="Jouer" />
            <ui:Button name="armoryButton" class="menu-button" text="Personnalisation" />
            <ui:Button name="optionsButton" class="menu-button" text="Options" />
            <ui:Button name="quitButton" class="menu-button menu-button--quit" text="Quitter" />
        </ui:VisualElement>

        <!-- ================= Jouer : créer une partie, ou la rejoindre par son code ================= -->
        <ui:VisualElement name="screenPlay" class="screen screen--wide hidden">
            <ui:VisualElement class="panel">
                <ui:VisualElement class="pseudo-row">
                    <ui:Label class="pseudo-label" text="PSEUDO" />
                    <ui:TextField name="pseudoField" class="text-field pseudo-field" max-length="16" />
                    <ui:Label class="pseudo-hint" text="Vu par les autres joueurs. Vide : « Joueur 1 », « Joueur 2 »…" />
                </ui:VisualElement>

                <ui:VisualElement class="play-split">
                    <ui:VisualElement class="play-card">
                        <ui:Label class="section-label section-label--accent" text="CRÉER UNE PARTIE" />
                        <ui:Label class="play-card-text" text="Ouvre un salon privé et reçois un code à donner à tes amis. Le mode et les réglages se choisissent dans le salon, puis tu lances la partie." />
                        <ui:Button name="createButton" class="menu-button menu-button--primary play-card-button" text="Créer une partie" />
                    </ui:VisualElement>

                    <ui:VisualElement class="play-card play-card--last">
                        <ui:Label class="section-label section-label--accent" text="REJOINDRE UNE PARTIE" />
                        <ui:Label class="play-card-text" text="Tape le code que l'hôte t'a donné : tu arrives dans son salon, ou directement dans l'arène si la partie est lancée." />
                        <ui:TextField name="joinCodeField" class="text-field code-field" max-length="16" />
                        <ui:Button name="joinCodeButton" class="menu-button menu-button--primary play-card-button" text="Rejoindre" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="playStatusLabel" class="status-label" text="" />

                <!-- Sans les services en ligne : sur le même réseau, par l'adresse de l'hôte. Sert aussi
                     au banc de test à deux instances (CLAUDE.md). Les réglages sont ceux de la dernière
                     partie créée. -->
                <ui:Foldout name="lanFoldout" class="lan-foldout" text="Réseau local, sans code" value="false">
                    <ui:VisualElement class="host-join-split">
                        <ui:VisualElement class="host-join-column">
                            <ui:Label class="section-label" text="HÉBERGER SUR CE RÉSEAU" />
                            <ui:Label class="field-label" text="Port d'écoute" />
                            <ui:TextField name="hostPortField" class="text-field" value="7777" max-length="5" />
                            <ui:Label name="lanRulesLabel" class="rule-hint" text="" />
                            <ui:Button name="hostButton" class="menu-button" text="Héberger" />
                            <ui:Label name="localIpLabel" class="local-ip-label" text="" />
                        </ui:VisualElement>

                        <ui:VisualElement class="host-join-column host-join-column--last">
                            <ui:Label class="section-label" text="REJOINDRE UNE ADRESSE" />
                            <ui:Label class="field-label" text="Adresse IP de l'hôte" />
                            <ui:TextField name="joinIpField" class="text-field" value="127.0.0.1" />
                            <ui:Label class="field-label" text="Port" />
                            <ui:TextField name="joinPortField" class="text-field" value="7777" max-length="5" />
                            <ui:Button name="joinButton" class="menu-button" text="Rejoindre" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:Foldout>
            </ui:VisualElement>
            <ui:Button name="playBackButton" class="back-button" text="Retour" />
        </ui:VisualElement>

        <!-- ================= Salon : le code, les joueurs, le mode et les réglages ================= -->
        <ui:VisualElement name="screenLobby" class="screen screen--wide hidden">
            <ui:VisualElement class="panel">
                <ui:VisualElement class="lobby-header">
                    <ui:VisualElement class="lobby-title-block">
                        <ui:Label class="panel-title lobby-title" text="Salon privé" />
                        <ui:Label name="lobbyRoleLabel" class="lobby-role" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="lobby-code-block">
                        <ui:Label class="section-label lobby-code-caption" text="CODE DE LA PARTIE" />
                        <ui:VisualElement class="row">
                            <ui:Label name="lobbyCodeLabel" class="lobby-code" text="······" />
                            <ui:Button name="lobbyCopyButton" class="rule-chip lobby-copy" text="Copier" />
                        </ui:VisualElement>
                        <ui:Label class="rule-hint lobby-code-hint" text="Tes amis le tapent dans Jouer, Rejoindre une partie." />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="lobby-split">
                    <ui:VisualElement class="lobby-column">
                        <ui:Label name="lobbyPlayersTitle" class="section-label lobby-section-first" text="JOUEURS" />
                        <ui:VisualElement name="lobbyPlayerList" class="lobby-player-list" />
                        <ui:Label class="rule-hint" text="Les deux premiers arrivés se battent ; les autres attendent leur tour sur la tribune." />
                    </ui:VisualElement>

                    <ui:VisualElement class="lobby-column lobby-column--last">
                        <ui:Label class="section-label lobby-section-first" text="MODE" />
                        <ui:VisualElement name="lobbyModeRow" class="rule-row" />
                        <ui:Label class="section-label" text="PLACES (AU-DELÀ DE 2 : SPECTATEURS)" />
                        <ui:VisualElement name="lobbyCapacityRow" class="rule-row" />
                        <ui:Label class="section-label" text="ORGANISATION DES DUELS" />
                        <ui:VisualElement name="lobbyOrganizationRow" class="rule-row" />
                        <ui:Toggle name="lobbyInterventionsToggle" class="rule-toggle" label="Les spectateurs interviennent (cailloux, matériel, bagarre)" />
                        <ui:Label name="lobbyRulesHint" class="rule-hint" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="lobby-footer">
                    <ui:Label name="lobbyStatusLabel" class="status-label lobby-status" text="" />
                    <ui:Button name="lobbyStartButton" class="menu-button menu-button--primary lobby-start" text="Lancer la partie" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="lobbyLeaveButton" class="back-button" text="Quitter le salon" />
        </ui:VisualElement>

        <!-- ================= Personnalisation (refaite le 2026-10-16 : deux parties, le robot et les armes) =================
             Même disposition plein écran que l'armurerie. À gauche le ROBOT (sans arme, en attente, qui tourne) et sa
             couleur ; à droite les ARMES, résumées, qui ouvrent l'armurerie. Les pastilles et les lignes des armes sont
             créées par ArmoryController. -->
        <ui:VisualElement name="screenArmory" class="gunsmith hidden">
            <ui:VisualElement class="gunsmith-topbar">
                <ui:VisualElement class="gunsmith-brand">
                    <ui:Label class="gunsmith-logo" text="DUEL ARENA" />
                    <ui:Label class="gunsmith-screen-title" text="PERSONNALISATION" />
                </ui:VisualElement>
                <ui:VisualElement class="custom-topbar-spacer" />
                <ui:VisualElement class="gunsmith-player-card">
                    <ui:VisualElement name="customPlayerColor" class="gunsmith-player-color" />
                    <ui:VisualElement class="gunsmith-player-text">
                        <ui:Label name="customPlayerName" class="gunsmith-player-name" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="custom-body">
                <!-- Le robot -->
                <ui:VisualElement class="custom-half">
                    <ui:VisualElement class="custom-half-header">
                        <ui:Label class="custom-half-title" text="ROBOT" />
                        <ui:Label class="custom-half-subtitle" text="Ton châssis, tel que les autres joueurs le voient." />
                    </ui:VisualElement>
                    <ui:Image name="characterPreviewImage" class="custom-robot-view" />
                    <ui:Label class="custom-section" text="COULEUR" />
                    <ui:VisualElement name="colorSwatchRow" class="custom-swatch-row" />
                    <ui:Label name="colorRuleLabel" class="custom-hint" text="" />
                </ui:VisualElement>

                <!-- Les armes -->
                <ui:VisualElement class="custom-half custom-half--last">
                    <ui:VisualElement class="custom-half-header">
                        <ui:Label class="custom-half-title" text="ARMES" />
                        <ui:Label class="custom-half-subtitle" text="Le modèle, la finition et les accessoires de chaque arme." />
                    </ui:VisualElement>
                    <ui:VisualElement name="weaponSummaryList" class="custom-weapon-list" />
                    <ui:Button name="openWeaponCustomizeButton" class="menu-button menu-button--primary custom-open-armory" text="Ouvrir l'armurerie" />
                    <ui:Label class="custom-hint" text="L'arme elle-même se choisit avant chaque manche, pendant la préparation (clic ou touches 1 à 4)." />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="gunsmith-footer">
                <ui:Button name="armoryBackButton" class="back-button key-hint">
                    <ui:Label class="key-cap" text="ÉCHAP" />
                    <ui:Label class="key-action" text="Retour" />
                </ui:Button>
                <ui:VisualElement class="key-hint key-hint--static">
                    <ui:Label class="key-cap" text="GLISSER" />
                    <ui:Label class="key-action" text="Tourner le robot" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= Armurerie (refaite le 2026-10-16 sur la disposition de Call of Duty) =================
             Écran plein : en haut les classes et la carte du joueur ; à gauche la carte de l'arme, ses
             tuiles et la bande des choix ; à droite l'arme en grand, sa fiche et le mot de l'IA ; en bas
             les touches. Les tuiles, les choix et les barres sont créés par WeaponCustomizationController. -->
        <ui:VisualElement name="screenWeaponCustomize" class="gunsmith hidden">
            <ui:VisualElement class="gunsmith-topbar">
                <ui:VisualElement class="gunsmith-brand">
                    <ui:Label class="gunsmith-logo" text="DUEL ARENA" />
                    <ui:Label class="gunsmith-screen-title" text="ARMURERIE" />
                </ui:VisualElement>
                <ui:VisualElement name="gunsmithTabs" class="gunsmith-tabs" />
                <ui:VisualElement class="gunsmith-player-card">
                    <ui:VisualElement name="gunsmithPlayerColor" class="gunsmith-player-color" />
                    <ui:VisualElement class="gunsmith-player-text">
                        <ui:Label name="gunsmithPlayerName" class="gunsmith-player-name" text="" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="gunsmith-body">
                <ui:VisualElement class="gunsmith-left">
                    <ui:VisualElement class="gunsmith-header-card">
                        <ui:VisualElement class="gunsmith-slot-badge">
                            <ui:Label name="gunsmithSlotKey" class="gunsmith-slot-key" text="1" />
                            <ui:Label class="gunsmith-slot-caption" text="TOUCHE" />
                        </ui:VisualElement>
                        <ui:VisualElement class="gunsmith-header-text">
                            <ui:Label name="gunsmithClassLabel" class="gunsmith-class" text="" />
                            <ui:VisualElement class="gunsmith-model-row">
                                <ui:Label name="gunsmithModelLabel" class="gunsmith-model" text="" />
                                <ui:Label name="gunsmithFamilyTag" class="gunsmith-family-tag" text="" />
                            </ui:VisualElement>
                            <ui:Label name="gunsmithDescription" class="gunsmith-description" text="" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Label class="gunsmith-section" text="ACCESSOIRES" />
                    <ui:VisualElement name="gunsmithAttachmentGrid" class="gunsmith-grid" />
                    <ui:Label class="gunsmith-section" text="APPARENCE" />
                    <ui:VisualElement name="gunsmithLookGrid" class="gunsmith-grid" />

                    <ui:VisualElement class="gunsmith-strip-header">
                        <ui:Label name="gunsmithStripTitle" class="gunsmith-section gunsmith-strip-title" text="" />
                        <ui:Label name="gunsmithStripCount" class="gunsmith-strip-count" text="" />
                    </ui:VisualElement>
                    <ui:VisualElement class="gunsmith-strip">
                        <ui:Button name="gunsmithStripPrev" class="gunsmith-arrow" text="‹" />
                        <ui:ScrollView name="gunsmithStripScroll" class="gunsmith-strip-scroll" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
                        <ui:Button name="gunsmithStripNext" class="gunsmith-arrow" text="›" />
                    </ui:VisualElement>

                    <ui:VisualElement class="gunsmith-left-spacer" />
                    <ui:Label class="gunsmith-left-hint" text="Tout est ouvert à tous. Les accessoires changent l'arme (recul, épaulement, chargeur) ; le modèle et la finition ne changent que son apparence, vue par tous les joueurs. Les dégâts sont ceux de la classe." />
                </ui:VisualElement>

                <ui:VisualElement class="gunsmith-right">
                    <ui:Image name="gunsmithPreview" class="gunsmith-preview" />
                    <ui:VisualElement class="gunsmith-bottom-right">
                        <ui:Label class="gunsmith-drag-hint" text="Glisse sur l'arme pour la faire tourner" />
                        <ui:VisualElement class="gunsmith-stats-column">
                            <ui:VisualElement class="gunsmith-stats">
                                <ui:VisualElement class="gunsmith-stats-header">
                                    <ui:Label class="gunsmith-section gunsmith-stats-title" text="CARACTÉRISTIQUES" />
                                    <ui:Label name="gunsmithStatsLegend" class="gunsmith-stats-legend" text="" />
                                </ui:VisualElement>
                                <ui:VisualElement name="gunsmithStatRows" />
                                <ui:VisualElement name="gunsmithInfoGrid" class="gunsmith-info-grid" />
                            </ui:VisualElement>
                            <ui:VisualElement class="gunsmith-ai">
                                <ui:Label name="gunsmithAiHeader" class="gunsmith-ai-header" text="" />
                                <ui:Label name="gunsmithAiText" class="gunsmith-ai-text" text="" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="gunsmith-footer">
                <ui:Button name="gunsmithBackButton" class="back-button key-hint">
                    <ui:Label class="key-cap" text="ÉCHAP" />
                    <ui:Label class="key-action" text="Retour" />
                </ui:Button>
                <ui:VisualElement class="key-hint key-hint--static">
                    <ui:Label class="key-cap" text="F" />
                    <ui:Label class="key-action" text="Équiper (ou clic)" />
                </ui:VisualElement>
                <ui:VisualElement class="key-hint key-hint--static">
                    <ui:Label class="key-cap" text="← →" />
                    <ui:Label class="key-action" text="Prévisualiser" />
                </ui:VisualElement>
                <ui:VisualElement class="key-hint key-hint--static">
                    <ui:Label class="key-cap" text="↑ ↓" />
                    <ui:Label class="key-action" text="Tuile" />
                </ui:VisualElement>
                <ui:VisualElement class="key-hint key-hint--static">
                    <ui:Label class="key-cap" text="1 – 4" />
                    <ui:Label class="key-action" text="Arme" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ================= Options (panneau partagé avec le menu d'Échap) ================= -->
        <ui:VisualElement name="screenOptions" class="screen hidden">
            <ui:Instance template="OptionsPanel" class="options-instance" />
            <ui:Button name="optionsBackButton" class="back-button" text="Retour" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
