/* =====================================================================
   Les écrans du menu principal (2026-10-17, d'après les maquettes de
   l'utilisateur). La charte commune (boutons, onglets, carte du joueur,
   fenêtres) est dans Shared/Theme.uss ; le panneau des Options dans
   Shared/OptionsPanel.uss. Référence : 1920 × 1080.
   ===================================================================== */

.root {
    flex-grow: 1;
    background-color: var(--ink);
}

/* ---------- Le fond ---------- */

.backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.backdrop-shade-left {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    --gradient-from: rgba(6, 9, 13, 0.94);
    --gradient-to: rgba(6, 9, 13, 0);
    --gradient-vertical: 0;
    --gradient-start: 0.3;
    --gradient-end: 1;
}

.backdrop-shade-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34%;
    --gradient-from: rgba(6, 9, 13, 0);
    --gradient-to: rgba(6, 9, 13, 0.85);
    --gradient-vertical: 1;
    --gradient-start: 0;
    --gradient-end: 1;
}

.backdrop-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(7, 10, 14, 0.86);
}

/* ---------- Le cadre des écrans ---------- */

.da-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 34px 58px 24px 58px;
}

.da-frame {
    position: absolute;
    left: 20px;
    top: 20px;
    right: 20px;
    bottom: 20px;
    --edge-color: rgba(150, 170, 190, 0.16);
    --edge-width: 1;
    --cut-tl: 28;
    --cut-br: 28;
    --bracket-color: rgba(244, 190, 28, 0.7);
    --bracket-size: 26;
    --bracket-width: 2;
    --bracket-corners: 10;
}

/* ================= Écran titre ================= */

.title-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
}

.title-left {
    width: 560px;
    padding: 58px 0 36px 76px;
}

.title-right {
    flex-grow: 1;
    align-items: flex-end;
    padding: 28px 34px 30px 0;
}

.title-spacer {
    flex-grow: 1;
}

.title-logo-block {
    flex-direction: row;
    align-items: center;
}

.title-logo {
    width: 138px;
    height: 138px;
    margin-right: 30px;
}

.title-word {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Black.ttf");
    font-size: 84px;
    color: rgb(244, 244, 240);
    margin: -14px 0 -14px 0;
    padding: 0;
    letter-spacing: -1px;
}

.title-menu {
    margin-top: 64px;
    width: 452px;
}

.title-btn {
    height: 80px;
    margin-bottom: 12px;
    padding: 0 30px 0 34px;
    justify-content: flex-start;
}

.title-btn > .slant-bg {
    --fill-color: rgba(11, 15, 20, 0.86);
    --edge-color: rgba(150, 170, 190, 0.32);
    --cut-tl: 0;
    --cut-tr: 0;
    --cut-br: 26;
    --cut-bl: 0;
}

.title-btn:hover {
    translate: 8px 0;
}

.title-btn > .da-btn__icon {
    width: 32px;
    height: 32px;
    margin-right: 26px;
}

.title-btn > .da-btn__label {
    font-size: 27px;
    letter-spacing: 1.5px;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
}

.title-btn--primary {
    height: 88px;
}

.title-btn--primary > .slant-bg {
    --fill-color: rgb(244, 190, 28);
    --edge-width: 0;
}

.title-btn--primary:hover > .slant-bg {
    --fill-color: rgb(255, 211, 77);
}

.title-btn--primary > .da-btn__label {
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
}

.title-btn__bar {
    position: absolute;
    left: 14px;
    top: 14px;
    bottom: 14px;
    width: 6px;
    background-color: var(--on-yellow);
}

.title-btn__chevron {
    position: absolute;
    right: 34px;
    width: 26px;
    height: 26px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--on-yellow);
}

.title-tagline {
    flex-direction: row;
    margin-bottom: 18px;
    padding-left: 30px;
}

.title-tagline__accent,
.title-tagline__plain {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BoldItalic.ttf");
    font-size: 19px;
    letter-spacing: 1px;
    margin: 0 16px 0 0;
    padding: 0;
}

.title-tagline__accent {
    color: var(--yellow);
}

.title-tagline__plain {
    color: rgb(225, 228, 232);
}

.title-rule {
    height: 1px;
    margin-left: -76px;
    margin-bottom: 28px;
    background-color: rgba(150, 170, 190, 0.3);
}

.title-version {
    flex-direction: row;
    align-items: center;
}

.title-version__logo {
    width: 40px;
    height: 40px;
    margin-right: 14px;
}

.title-version__name {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.title-version__number {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 11px;
    color: var(--text-dim);
    margin: 2px 0 0 0;
    padding: 0;
}

.title-version__mark {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 26px;
    color: var(--yellow);
    margin: 0 0 0 26px;
    padding: 0;
}

.title-slogan {
    flex-direction: row;
    align-items: center;
    height: 54px;
    padding: 0 30px 0 34px;
    --fill-color: rgba(9, 12, 16, 0.82);
    --edge-color: rgba(150, 170, 190, 0.28);
    --edge-width: 1;
    --cut-tl: 26;
}

.title-slogan__mark {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 24px;
    color: var(--yellow);
    margin: 0 18px 0 0;
    padding: 0;
}

.title-slogan__text {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BoldItalic.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(214, 219, 224);
    margin: 0;
    padding: 0;
}

/* ================= Jouer ================= */

.play-body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 20px;
}

.play-main {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 22px;
}

.play-page {
    flex-grow: 1;
}

.card-grid {
    flex-grow: 1;
}

.card-row {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    margin-bottom: 16px;
}

.card-row--last {
    margin-bottom: 0;
}

.mode-card {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 16px 0 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(14, 19, 25);
    overflow: hidden;
    justify-content: flex-end;
}

.mode-card--row-end {
    margin-right: 0;
}

.mode-card__art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-size: 160% auto;
    -unity-background-image-tint-color: rgb(120, 128, 140);
}

/* Les deux grandes cartes de l'entraînement montrent toute leur image. */
#trainingGrid .mode-card__art {
    background-size: cover;
    background-position: center;
}

.mode-card:hover > .mode-card__art {
    -unity-background-image-tint-color: rgb(160, 168, 178);
}

.mode-card__robot {
    position: absolute;
    top: 6%;
    bottom: 0;
    width: 56%;
    -unity-background-scale-mode: scale-to-fit;
}

.mode-card__robot--center {
    left: 22%;
}

.mode-card__robot--left {
    left: 6%;
}

.mode-card__robot--right {
    right: 6%;
}

.mode-card__shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 58%;
    --gradient-from: rgba(8, 11, 15, 0);
    --gradient-to: rgba(8, 11, 15, 0.94);
    --gradient-vertical: 1;
}

.mode-card__icon {
    position: absolute;
    left: 16px;
    top: 14px;
    width: 26px;
    height: 26px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--yellow);
}

.mode-card__badge {
    position: absolute;
    right: 12px;
    top: 12px;
    padding: 4px 9px;
    background-color: rgba(9, 12, 16, 0.88);
    border-width: 1px;
    border-color: rgba(150, 170, 190, 0.4);
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 11px;
    color: var(--text-dim);
}

.mode-card__badge--live {
    border-color: var(--yellow);
    color: var(--yellow);
}

.mode-card__text {
    padding: 0 18px 16px 18px;
    -unity-text-align: lower-left;
}

.mode-card__title {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 23px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.mode-card__subtitle {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 2px 0 0 0;
    padding: 0;
}

.mode-card__lock {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 10, 14, 0.52);
}

.mode-card__lock-icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(232, 236, 240, 0.75);
    background-image: url("project://database/Assets/_ProjectUI/Icons/lock.svg");
}

.mode-card__edge {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --edge-color: rgba(150, 170, 190, 0.26);
    --edge-width: 1;
}

.mode-card:hover > .mode-card__edge {
    --edge-color: rgba(244, 190, 28, 0.6);
}

.mode-card--selected > .mode-card__edge,
.mode-card--selected:hover > .mode-card__edge {
    --edge-color: rgb(244, 190, 28);
    --edge-width: 2;
    --bracket-color: rgb(244, 190, 28);
    --bracket-size: 20;
    --bracket-width: 4;
    --bracket-corners: 5;
}

.mode-card--locked > .mode-card__text > .mode-card__title {
    color: rgb(170, 178, 188);
}

/* Le détail */

.play-detail {
    width: 440px;
    padding: 26px 26px 24px 26px;
}

.play-detail__head {
    flex-direction: row;
    align-items: center;
}

.play-detail__icon {
    width: 28px;
    height: 28px;
    margin-right: 12px;
    -unity-background-image-tint-color: var(--yellow);
}

.play-detail__text {
    margin-top: 10px;
    font-size: 16px;
    color: rgb(205, 211, 218);
}

.play-detail__image {
    height: 220px;
    margin-top: 18px;
    border-width: 1px;
    border-color: rgba(150, 170, 190, 0.3);
    background-color: rgb(14, 19, 25);
    -unity-background-scale-mode: scale-and-crop;
}

.play-detail__facts {
    margin-top: 16px;
}

.fact-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    border-bottom-width: 1px;
    border-color: rgba(150, 170, 190, 0.16);
}

.fact-row__label {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--text-dim);
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.fact-row__value {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 15px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.play-detail__spacer {
    flex-grow: 1;
}

.play-detail__status {
    margin-bottom: 12px;
}

.play-detail__button {
    height: 56px;
}

.play-detail__button > .da-btn__label {
    font-size: 19px;
}

/* Les salons */

.lobbies-panel {
    margin-bottom: 18px;
    padding: 26px 30px;
}

.lobbies-panel--last {
    margin-bottom: 0;
}

.lobbies-text {
    margin-bottom: 18px;
}

.join-row {
    flex-direction: row;
    align-items: center;
}

.join-code-field {
    width: 360px;
    height: 58px;
    margin-right: 16px;
}

.join-code-field > .unity-base-text-field__input {
    font-size: 30px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    color: var(--yellow);
}

.join-button {
    width: 220px;
    height: 58px;
}

.lan-split {
    flex-direction: row;
}

.lan-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 28px;
}

.lan-column--last {
    margin-right: 0;
}

.lan-label {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 0 0 8px 0;
    padding: 0;
}

.lan-address-row {
    flex-direction: row;
}

.lan-ip-field {
    flex-grow: 1;
    margin-right: 10px;
}

.lan-port-field {
    width: 110px;
}

.lan-button {
    margin-top: 12px;
    height: 46px;
}

.lan-note {
    margin-top: 10px;
}

/* ================= Salon ================= */

.lobby-headline-block {
    flex-direction: row;
    align-items: center;
    margin-left: 70px;
}

.lobby-spinner {
    width: 36px;
    height: 36px;
    margin-right: 16px;
}

.lobby-headline {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 24px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.lobby-subline {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 2px 0 0 0;
    padding: 0;
}

.lobby-body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 20px;
}

.lobby-main {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 22px;
}

.lobby-versus {
    flex-direction: row;
    align-items: center;
    height: 330px;
    flex-shrink: 0;
}

.lobby-vs {
    width: 120px;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 70px;
    color: rgb(240, 242, 245);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.duelist-card {
    flex-grow: 1;
    flex-basis: 0;
    height: 100%;
    flex-direction: row;
    overflow: hidden;
    --fill-color: rgba(12, 17, 23, 0.92);
    --edge-color: rgba(150, 170, 190, 0.3);
    --edge-width: 1;
    --cut-tl: 18;
    --cut-br: 18;
}

.duelist-card--self {
    --edge-color: rgb(244, 190, 28);
    --edge-width: 2;
    --bracket-color: rgb(244, 190, 28);
    --bracket-size: 22;
    --bracket-width: 3;
    --bracket-corners: 10;
}

.duelist-card__portrait {
    width: 48%;
    margin: 2px;
    -unity-background-scale-mode: scale-and-crop;
}

.duelist-card__unknown {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 48%;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 120px;
    color: rgba(232, 236, 240, 0.22);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.duelist-card__info {
    flex-grow: 1;
    flex-basis: 0;
    justify-content: center;
    padding: 0 22px 0 18px;
}

.duelist-card__role {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1.5px;
    color: var(--yellow);
    padding: 0 0 0 10px;
    margin: 0;
    border-left-width: 3px;
    border-color: var(--yellow);
}

.duelist-card__name {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Black.ttf");
    font-size: 30px;
    color: var(--text);
    margin: 10px 0 0 0;
    padding: 0;
    white-space: normal;
}

.duelist-card__status {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 22px;
    color: var(--green);
    margin: 14px 0 0 0;
    padding: 0;
}

.duelist-card__status--waiting {
    color: var(--text-dim);
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BoldItalic.ttf");
    font-size: 16px;
    white-space: normal;
}

.lobby-queue-header {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 26px;
    margin-bottom: 10px;
}

.lobby-queue-title {
    margin: 0 18px 0 0;
}

.lobby-queue-hint {
    flex-shrink: 1;
}

.lobby-queue {
    flex-grow: 1;
}

.queue-slot {
    flex-direction: row;
    align-items: center;
    height: 52px;
    margin-bottom: 8px;
    padding: 0 18px 0 14px;
    --fill-color: rgba(12, 17, 23, 0.9);
    --edge-color: rgba(150, 170, 190, 0.26);
    --edge-width: 1;
    --cut-br: 12;
}

.queue-slot--self {
    --edge-color: rgba(244, 190, 28, 0.85);
    --accent-color: rgb(244, 190, 28);
    --accent-width: 4;
}

.queue-slot--empty {
    --fill-color: rgba(12, 17, 23, 0.55);
    --edge-color: rgba(150, 170, 190, 0.14);
}

.queue-slot__logo {
    width: 30px;
    height: 30px;
    margin-right: 14px;
}

.queue-slot__empty-icon {
    width: 22px;
    height: 22px;
    margin: 0 18px 0 4px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(143, 155, 168, 0.4);
    background-image: url("project://database/Assets/_ProjectUI/Icons/user.svg");
}

.queue-slot__name {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 17px;
    color: var(--text);
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.queue-slot--empty > .queue-slot__name {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Regular.ttf");
    color: var(--text-faint);
}

.queue-slot__status {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 0;
    padding: 0;
}

.lobby-side {
    width: 540px;
    padding: 22px 26px 22px 26px;
}

.lobby-arena-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.lobby-arena-caption {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 0 8px 0 0;
    padding: 0;
}

.lobby-arena-name {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Black.ttf");
    font-size: 17px;
    letter-spacing: 1px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.lobby-map {
    height: 290px;
    flex-shrink: 0;
    background-color: rgb(10, 14, 19);
    border-width: 1px;
    border-color: rgba(150, 170, 190, 0.3);
}

.map-legend {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.map-legend__item {
    flex-direction: row;
    align-items: center;
    margin: 0 18px 6px 0;
}

.map-legend__swatch {
    width: 12px;
    height: 12px;
    margin-right: 7px;
}

.map-legend__label {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Medium.ttf");
    font-size: 12px;
    color: var(--text-dim);
    margin: 0;
    padding: 0;
}

.lobby-rules {
    margin-top: 10px;
}

.lobby-rule {
    flex-direction: row;
    align-items: center;
    height: 42px;
    border-bottom-width: 1px;
    border-color: rgba(150, 170, 190, 0.16);
}

.lobby-rule--last {
    border-bottom-width: 0;
}

.lobby-rule__label {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--text-dim);
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.lobby-rule__value {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 16px;
    color: var(--text);
    margin: 0 34px 0 0;
    padding: 0;
}

.lobby-rule__cycler {
    flex-grow: 0;
    width: 260px;
}

.lobby-rules-hint {
    margin-top: 6px;
}

.lobby-code-block {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    padding-top: 14px;
    border-top-width: 1px;
    border-color: rgba(150, 170, 190, 0.2);
}

.lobby-code-text {
    flex-grow: 1;
}

.lobby-code-caption {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1.5px;
    color: var(--text-dim);
    margin: 0;
    padding: 0;
}

.lobby-code {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 32px;
    letter-spacing: 5px;
    color: var(--yellow);
    margin: 2px 0 0 0;
    padding: 0;
}

.lobby-copy {
    width: 150px;
    height: 46px;
}

.lobby-leave {
    width: 280px;
    height: 50px;
}

.lobby-status {
    margin-right: 20px;
    -unity-text-align: middle-right;
}

.lobby-start {
    width: 320px;
    height: 56px;
}

.lobby-start > .da-btn__label {
    font-size: 20px;
}

/* ================= Personnalisation ================= */

.custom-body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 20px;
}

.side-list {
    width: 330px;
}

.side-btn {
    height: 76px;
    margin-bottom: 12px;
    padding: 0 20px 0 22px;
    justify-content: flex-start;
}

.side-btn > .slant-bg {
    --fill-color: rgba(12, 17, 23, 0.9);
    --edge-color: rgba(150, 170, 190, 0.3);
    --cut-tl: 0;
    --cut-br: 16;
}

.side-btn > .side-btn__icon {
    width: 30px;
    height: 30px;
    margin-right: 20px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text);
}

.side-btn:hover > .side-btn__icon {
    -unity-background-image-tint-color: var(--yellow);
}

.side-btn__thumb {
    width: 112px;
    height: 56px;
    margin-right: 16px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.side-btn__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.side-btn__title {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    -unity-text-align: middle-left;
    font-size: 19px;
    letter-spacing: 1px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.side-btn__subtitle {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    -unity-text-align: middle-left;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 3px 0 0 0;
    padding: 0;
}

.side-btn:hover > .side-btn__text > .side-btn__title {
    color: var(--yellow);
}

.side-btn__key {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 12px;
    color: var(--text-dim);
    padding: 3px 7px;
    margin: 0 0 0 8px;
    border-width: 1px;
    border-color: rgba(150, 170, 190, 0.4);
    border-radius: 3px;
}

.side-btn__lock {
    width: 16px;
    height: 16px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-faint);
    background-image: url("project://database/Assets/_ProjectUI/Icons/lock.svg");
}

.side-btn--active > .slant-bg,
.side-btn--active:hover > .slant-bg {
    --fill-color: rgb(244, 190, 28);
    --edge-width: 0;
}

.side-btn--active > .side-btn__icon,
.side-btn--active:hover > .side-btn__icon {
    -unity-background-image-tint-color: var(--on-yellow);
}

.side-btn--active > .side-btn__text > .side-btn__title,
.side-btn--active:hover > .side-btn__text > .side-btn__title {
    color: var(--on-yellow);
}

.side-btn--active > .side-btn__text > .side-btn__subtitle {
    color: rgba(18, 22, 28, 0.75);
}

.side-btn--active > .side-btn__key {
    color: var(--on-yellow);
    border-color: rgba(18, 22, 28, 0.5);
}

.side-btn:disabled > .side-btn__text > .side-btn__title {
    color: var(--text-faint);
}

.side-btn:disabled > .side-btn__icon {
    -unity-background-image-tint-color: var(--text-faint);
}

.custom-stage {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 22px;
}

.custom-stage__view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.custom-stage__hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Medium.ttf");
    font-size: 13px;
    color: var(--text-faint);
    -unity-text-align: middle-center;
}

.custom-stage__hint--top {
    top: 4px;
    bottom: auto;
}

.custom-side {
    width: 490px;
    padding: 22px 24px;
}

.custom-side__spacer {
    flex-grow: 1;
}

/* La grille du robot */

.robot-grid {
    margin-top: 4px;
}

.grid-row {
    flex-direction: row;
    margin-bottom: 12px;
}

.robot-tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 176px;
    margin: 0 12px 0 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(14, 19, 25);
    justify-content: flex-end;
    overflow: hidden;
}

.robot-tile--row-end {
    margin-right: 0;
}

.robot-tile--placeholder {
    background-color: rgba(0, 0, 0, 0);
}

.robot-tile__art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.robot-tile__name {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    margin: 0 0 6px 0;
    padding: 0;
}

.robot-tile--selected > .robot-tile__name {
    color: var(--yellow);
}

.robot-tile__check {
    position: absolute;
    right: 8px;
    top: 8px;
    width: 22px;
    height: 22px;
    background-color: var(--yellow);
    align-items: center;
    justify-content: center;
}

.robot-tile__check-icon {
    width: 14px;
    height: 14px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--on-yellow);
    background-image: url("project://database/Assets/_ProjectUI/Icons/check.svg");
}

.robot-tile__edge {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --edge-color: rgba(150, 170, 190, 0.26);
    --edge-width: 1;
}

.robot-tile:hover > .robot-tile__edge {
    --edge-color: rgba(244, 190, 28, 0.6);
}

.robot-tile--selected > .robot-tile__edge,
.robot-tile--selected:hover > .robot-tile__edge {
    --edge-color: rgb(244, 190, 28);
    --edge-width: 2;
    --bracket-color: rgb(244, 190, 28);
    --bracket-size: 16;
    --bracket-width: 3;
}

.robot-info {
    padding: 2px 0 2px 16px;
    border-left-width: 3px;
    border-color: var(--yellow);
}

.robot-info__name {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 0;
    padding: 0;
}

.robot-info__title {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 28px;
    color: var(--text);
    margin: 4px 0 0 0;
    padding: 0;
}

.robot-info__text {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Regular.ttf");
    font-size: 14px;
    color: var(--text-dim);
    white-space: normal;
    margin: 6px 0 0 0;
    padding: 0;
}

/* Les armes : la liste, l'arme, ses emplacements */

.weapon-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

.slot-row {
    flex-direction: row;
    justify-content: center;
}

.slot-btn {
    width: 116px;
    height: 112px;
    margin: 0 5px;
    padding: 12px 6px 10px 6px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(12, 17, 23, 0.92);
    align-items: center;
    justify-content: flex-start;
}

.slot-btn--group-start {
    margin-left: 26px;
}

.slot-btn__icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text);
}

.slot-btn__label {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 13px;
    color: var(--text);
    margin: 10px 0 0 0;
    padding: 0;
}

.slot-btn__value {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 11px;
    color: var(--yellow);
    margin: 4px 0 0 0;
    padding: 0;
}

.slot-btn__edge {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --edge-color: rgba(150, 170, 190, 0.32);
    --edge-width: 1;
}

.slot-btn:hover > .slot-btn__edge {
    --edge-color: rgba(244, 190, 28, 0.7);
}

.slot-btn--open > .slot-btn__edge,
.slot-btn--open:hover > .slot-btn__edge {
    --edge-color: rgb(244, 190, 28);
    --edge-width: 2;
    --bracket-color: rgb(244, 190, 28);
    --bracket-size: 14;
    --bracket-width: 3;
}

.slot-btn--open > .slot-btn__icon {
    -unity-background-image-tint-color: var(--yellow);
}

.slot-btn:disabled {
    opacity: 1;
}

.slot-btn:disabled > .slot-btn__icon {
    -unity-background-image-tint-color: rgba(143, 155, 168, 0.35);
}

.slot-btn:disabled > .slot-btn__label,
.slot-btn:disabled > .slot-btn__value {
    color: var(--text-faint);
}

.slot-strip {
    align-self: stretch;
    margin: 0 0 14px 0;
    padding: 14px 16px 16px 16px;
    --fill-color: rgba(10, 14, 19, 0.95);
    --edge-color: rgba(150, 170, 190, 0.3);
    --edge-width: 1;
    --cut-tr: 14;
    --cut-bl: 14;
}

.slot-strip__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.slot-strip__title {
    margin: 0 14px 0 0;
    color: var(--yellow);
}

.slot-strip__row {
    flex-direction: row;
    align-items: center;
}

.slot-strip__scroll {
    flex-grow: 1;
    flex-basis: 0;
}

.slot-strip__scroll .unity-scroll-view__content-container {
    flex-direction: row;
}

.strip-arrow {
    width: 34px;
    height: 120px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.strip-arrow:hover {
    background-color: rgba(244, 190, 28, 0.12);
}

.strip-arrow__icon {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--yellow);
}

.strip-arrow:disabled {
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
}

.strip-arrow:disabled > .strip-arrow__icon {
    -unity-background-image-tint-color: rgba(143, 155, 168, 0.2);
}

.choice-card {
    width: 168px;
    height: 128px;
    margin: 0 10px 0 0;
    padding: 0 10px 10px 10px;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(16, 22, 29);
    justify-content: flex-end;
    flex-shrink: 0;
}

.choice-card__art {
    position: absolute;
    left: 6px;
    top: 6px;
    right: 6px;
    bottom: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.choice-card__code {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 48px;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 22px;
    color: rgba(232, 236, 240, 0.85);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.choice-card__title {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    -unity-text-align: middle-left;
    font-size: 13px;
    color: var(--text);
    margin: 0;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.choice-card__effect {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Regular.ttf");
    -unity-text-align: middle-left;
    font-size: 11px;
    color: var(--text-dim);
    margin: 2px 0 0 0;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.choice-card__tag {
    position: absolute;
    left: 8px;
    top: 8px;
    padding: 2px 6px;
    background-color: var(--yellow);
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Black.ttf");
    font-size: 10px;
    color: var(--on-yellow);
    display: none;
}

.choice-card--equipped > .choice-card__tag {
    display: flex;
}

.choice-card__edge {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --edge-color: rgba(150, 170, 190, 0.26);
    --edge-width: 1;
}

.choice-card:hover > .choice-card__edge,
.choice-card--previewed > .choice-card__edge {
    --edge-color: rgba(244, 190, 28, 0.75);
}

.choice-card--equipped > .choice-card__edge,
.choice-card--equipped:hover > .choice-card__edge {
    --edge-color: rgb(244, 190, 28);
    --edge-width: 2;
}

/* La fiche de l'arme */

.weapon-head {
    padding-left: 14px;
    border-left-width: 4px;
    border-color: var(--yellow);
}

.weapon-head__model {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 34px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.weapon-head__class {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1.5px;
    color: var(--yellow);
    margin: 2px 0 0 0;
    padding: 0;
}

.weapon-description {
    margin-top: 12px;
    font-size: 14px;
}

.weapon-stats-head {
    flex-direction: row;
    align-items: center;
    margin-top: 18px;
    margin-bottom: 4px;
}

.weapon-stats-title {
    margin: 0;
    flex-grow: 1;
}

.weapon-stats-legend {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--yellow);
    margin: 0;
    padding: 0;
}

.stat-row {
    margin-top: 9px;
}

.stat-row__head {
    flex-direction: row;
    align-items: center;
}

.stat-row__label {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--text);
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.stat-row__value {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 14px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.stat-row__value--gain {
    color: var(--green);
}

.stat-row__value--loss {
    color: var(--red);
}

.stat-row__track {
    height: 5px;
    margin-top: 5px;
    background-color: rgba(255, 255, 255, 0.12);
}

.stat-row__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(236, 239, 242);
}

.stat-row__delta {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
}

.stat-row__delta--gain {
    background-color: var(--green);
}

.stat-row__delta--loss {
    background-color: var(--red);
}

.info-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 16px;
}

.info-cell {
    width: 50%;
    margin-bottom: 10px;
}

.info-cell__caption {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 0;
    padding: 0;
}

.info-cell__value {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 14px;
    color: var(--text);
    margin: 2px 0 0 0;
    padding: 0;
    white-space: normal;
}

.ai-box {
    height: 112px;
    flex-shrink: 0;
    padding: 10px 12px;
    border-width: 1px;
    border-color: rgba(244, 190, 28, 0.35);
    background-color: rgba(6, 9, 13, 0.75);
}

.ai-box__header {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 11px;
    color: var(--yellow);
    margin: 0 0 6px 0;
    padding: 0;
}

.ai-box__text {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 12px;
    color: rgb(205, 211, 218);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.footer-hints {
    flex-direction: row;
    align-items: center;
    margin-left: 20px;
}

/* ================= Options ================= */

.options-screen > .options-instance {
    flex-grow: 1;
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    margin-top: 6px;
}

.options-note {
    margin-left: 20px;
}

/* ================= Fenêtres ================= */

.modal-back {
    align-self: center;
}

/* ---------- La carte de l'arène (ArenaMapView) ---------- */

.arena-map {
    overflow: hidden;
}

.arena-map__image {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(128, 142, 166);
}

.arena-map__overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.map-marker {
    position: absolute;
    width: 26px;
    height: 26px;
    margin-left: -13px;
    margin-top: -13px;
    align-items: center;
    justify-content: center;
}

.map-marker__shape {
    position: absolute;
    width: 18px;
    height: 18px;
    rotate: 45deg;
    border-width: 2px;
    border-color: rgb(18, 22, 28);
}

.map-marker--spawn > .map-marker__shape {
    background-color: rgb(244, 190, 28);
}

.map-marker--rock {
    width: 14px;
    height: 14px;
    margin-left: -7px;
    margin-top: -7px;
}

.map-marker--rock > .map-marker__shape {
    width: 9px;
    height: 9px;
    border-width: 1px;
    background-color: rgb(242, 128, 51);
}

.map-marker__label {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Black.ttf");
    font-size: 12px;
    color: rgb(18, 22, 28);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.map-legend__swatch--spawn {
    width: 10px;
    height: 10px;
    rotate: 45deg;
    background-color: rgb(244, 190, 28);
}

.map-legend__swatch--walkway {
    width: 18px;
    height: 3px;
    background-color: rgb(92, 214, 242);
}

.map-legend__swatch--rock {
    width: 8px;
    height: 8px;
    rotate: 45deg;
    background-color: rgb(242, 128, 51);
}
