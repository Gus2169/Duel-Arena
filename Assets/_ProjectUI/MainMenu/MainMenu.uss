/* =====================================================================
   Les écrans du menu principal (2026-10-17, d'après les maquettes de
   l'utilisateur). La charte commune (boutons, onglets, carte du joueur,
   fenêtres) est dans Shared/Theme.uss ; le panneau des Options dans
   Shared/OptionsPanel.uss. Référence : 1920 × 1080.
   ===================================================================== */

.root {
    flex-grow: 1;
    background-color: var(--ink);
}

/* ---------- Le fond ---------- */

.backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.backdrop-shade-left {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    --gradient-from: rgba(6, 9, 13, 0.94);
    --gradient-to: rgba(6, 9, 13, 0);
    --gradient-vertical: 0;
    --gradient-start: 0.3;
    --gradient-end: 1;
}

.backdrop-shade-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34%;
    --gradient-from: rgba(6, 9, 13, 0);
    --gradient-to: rgba(6, 9, 13, 0.85);
    --gradient-vertical: 1;
    --gradient-start: 0;
    --gradient-end: 1;
}

.backdrop-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(7, 10, 14, 0.86);
}

/* ---------- Le cadre des écrans ---------- */

.da-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 34px 58px 24px 58px;
}

.da-frame {
    position: absolute;
    left: 20px;
    top: 20px;
    right: 20px;
    bottom: 20px;
    --edge-color: rgba(150, 170, 190, 0.16);
    --edge-width: 1;
    --cut-tl: 28;
    --cut-br: 28;
    --bracket-color: rgba(244, 190, 28, 0.7);
    --bracket-size: 26;
    --bracket-width: 2;
    --bracket-corners: 10;
}

/* ================= Écran titre ================= */

.title-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
}

.title-left {
    width: 560px;
    padding: 58px 0 36px 76px;
}

.title-right {
    flex-grow: 1;
    align-items: flex-end;
    padding: 28px 34px 30px 0;
}

.title-spacer {
    flex-grow: 1;
}

.title-logo-block {
    flex-direction: row;
    align-items: center;
}

.title-logo {
    width: 138px;
    height: 138px;
    margin-right: 30px;
}

.title-word {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Black.ttf");
    font-size: 84px;
    color: rgb(244, 244, 240);
    margin: -14px 0 -14px 0;
    padding: 0;
    letter-spacing: -1px;
}

.title-menu {
    margin-top: 64px;
    width: 452px;
}

.title-btn {
    height: 80px;
    margin-bottom: 12px;
    padding: 0 30px 0 34px;
    justify-content: flex-start;
}

.title-btn > .slant-bg {
    --fill-color: rgba(11, 15, 20, 0.86);
    --edge-color: rgba(150, 170, 190, 0.32);
    --cut-tl: 0;
    --cut-tr: 0;
    --cut-br: 26;
    --cut-bl: 0;
}

.title-btn:hover {
    translate: 8px 0;
}

.title-btn > .da-btn__icon {
    width: 32px;
    height: 32px;
    margin-right: 26px;
}

.title-btn > .da-btn__label {
    font-size: 27px;
    letter-spacing: 1.5px;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
}

.title-btn--primary {
    height: 88px;
}

.title-btn--primary > .slant-bg {
    --fill-color: rgb(244, 190, 28);
    --edge-width: 0;
}

.title-btn--primary:hover > .slant-bg {
    --fill-color: rgb(255, 211, 77);
}

.title-btn--primary > .da-btn__label {
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
}

.title-btn__bar {
    position: absolute;
    left: 14px;
    top: 14px;
    bottom: 14px;
    width: 6px;
    background-color: var(--on-yellow);
}

.title-btn__chevron {
    position: absolute;
    right: 34px;
    width: 26px;
    height: 26px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--on-yellow);
}

.title-tagline {
    flex-direction: row;
    margin-bottom: 18px;
    padding-left: 30px;
}

.title-tagline__accent,
.title-tagline__plain {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BoldItalic.ttf");
    font-size: 19px;
    letter-spacing: 1px;
    margin: 0 16px 0 0;
    padding: 0;
}

.title-tagline__accent {
    color: var(--yellow);
}

.title-tagline__plain {
    color: rgb(225, 228, 232);
}

.title-rule {
    height: 1px;
    margin-left: -76px;
    margin-bottom: 28px;
    background-color: rgba(150, 170, 190, 0.3);
}

.title-version {
    flex-direction: row;
    align-items: center;
}

.title-version__logo {
    width: 40px;
    height: 40px;
    margin-right: 14px;
}

.title-version__name {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.title-version__number {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 11px;
    color: var(--text-dim);
    margin: 2px 0 0 0;
    padding: 0;
}

.title-version__mark {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 26px;
    color: var(--yellow);
    margin: 0 0 0 26px;
    padding: 0;
}

.title-slogan {
    flex-direction: row;
    align-items: center;
    height: 54px;
    padding: 0 30px 0 34px;
    --fill-color: rgba(9, 12, 16, 0.82);
    --edge-color: rgba(150, 170, 190, 0.28);
    --edge-width: 1;
    --cut-tl: 26;
}

.title-slogan__mark {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 24px;
    color: var(--yellow);
    margin: 0 18px 0 0;
    padding: 0;
}

.title-slogan__text {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BoldItalic.ttf");
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(214, 219, 224);
    margin: 0;
    padding: 0;
}

/* ================= Jouer ================= */

.play-body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 20px;
}

.play-main {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 22px;
}

.play-page {
    flex-grow: 1;
}

.card-grid {
    flex-grow: 1;
}

.card-row {
    flex-direction: row;
    flex-grow: 1;
    flex-basis: 0;
    margin-bottom: 16px;
}

.card-row--last {
    margin-bottom: 0;
}

/* Une carte de mode (2026-11-02, maquette « A · Jouer » retenue par l'utilisateur) : l'icône du mode, son
   nom, une ligne, et deux étiquettes (le rythme, les joueurs). La carte choisie est cernée de jaune et dit
   « CHOISI » ; un mode qui n'existe pas encore est bien éteint, sous un cadenas, et ne se choisit pas. */
.mode-tile {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    margin: 0 16px 0 0;
    padding: 24px 26px 22px 26px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(14, 19, 26, 0.94);
    align-items: stretch;
    justify-content: flex-start;
}

.mode-tile:hover:enabled,
.mode-tile:hover:active:enabled {
    background-color: rgba(22, 29, 39, 0.97);
}

.mode-tile--row-end {
    margin-right: 0;
}

.mode-tile__top {
    flex-direction: row;
    align-items: flex-start;
    height: 44px;
    margin-bottom: 18px;
}

.mode-tile__icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--yellow);
}

.mode-tile__spacer {
    flex-grow: 1;
}

.mode-tile__tag {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--on-yellow);
    background-color: var(--yellow);
    padding: 4px 8px;
    margin: 0;
}

.mode-tile__lock {
    position: absolute;
    left: 50%;
    top: 0;
    width: 40px;
    height: 44px;
    translate: -50% 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(104, 112, 122);
    background-image: url("project://database/Assets/_ProjectUI/Icons/lock.svg");
}

.mode-tile__title {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 28px;
    color: var(--text);
    /* Un Label hérite du centrage du bouton : à gauche, comme la maquette. */
    -unity-text-align: upper-left;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.mode-tile--selected .mode-tile__title {
    color: var(--yellow);
}

.mode-tile__line {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Regular.ttf");
    font-size: 16px;
    color: rgb(178, 189, 200);
    -unity-text-align: upper-left;
    white-space: normal;
    margin: 8px 0 0 0;
    padding: 0;
}

.mode-tile__fill {
    flex-grow: 1;
}

.mode-tile__chips {
    flex-direction: row;
    margin-top: 12px;
}

.mode-tile__chip {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1.5px;
    color: rgb(197, 206, 215);
    padding: 4px 8px;
    margin: 0 8px 0 0;
    border-width: 1px;
    border-color: rgba(150, 170, 190, 0.35);
}

.mode-tile__edge {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --edge-color: rgba(150, 170, 190, 0.26);
    --edge-width: 1;
    --cut-br: 14;
}

.mode-tile:hover:enabled > .mode-tile__edge {
    --edge-color: rgba(244, 190, 28, 0.6);
}

.mode-tile--selected > .mode-tile__edge,
.mode-tile--selected:hover:enabled > .mode-tile__edge {
    --edge-color: rgb(244, 190, 28);
    --edge-width: 2;
}

.mode-tile--selected {
    background-color: rgba(22, 29, 39, 0.97);
}

/* Un mode à venir : tout s'éteint, un cadenas au milieu du haut, son étiquette (« BIENTÔT ») en gris. La
   carte ne réagit ni au survol ni au clic (désactivée, PlayScreenController). */
.mode-tile--locked:disabled {
    opacity: 1;
    background-color: rgba(10, 14, 19, 0.9);
}

.mode-tile--locked .mode-tile__icon {
    -unity-background-image-tint-color: rgb(70, 77, 86);
}

.mode-tile--locked .mode-tile__tag {
    color: rgb(104, 113, 124);
    background-color: rgba(0, 0, 0, 0);
    padding: 4px 0;
}

.mode-tile--locked .mode-tile__title {
    color: rgb(80, 88, 98);
}

.mode-tile--locked .mode-tile__line,
.mode-tile--locked .mode-tile__chip {
    color: rgb(62, 69, 78);
}

.mode-tile--locked .mode-tile__chip {
    border-color: rgba(150, 170, 190, 0.12);
}

.mode-tile--locked > .mode-tile__edge {
    --edge-color: rgba(150, 170, 190, 0.1);
}

/* La place d'une carte absente : rien ne se voit. */
.mode-tile--spacer {
    background-color: rgba(0, 0, 0, 0);
}

/* La fiche du mode choisi : l'image de l'arène en haut, le nom, ce qu'il faut savoir, et l'action. */

.play-detail {
    width: 600px;
    padding: 0 30px 28px 30px;
    overflow: hidden;
}

.play-detail__image {
    height: 270px;
    margin: 0 -30px 0 -30px;
    background-color: rgb(14, 19, 25);
    -unity-background-scale-mode: scale-and-crop;
}

.play-detail__caption {
    position: absolute;
    left: 24px;
    bottom: 0;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--text);
    background-color: rgba(9, 12, 16, 0.92);
    padding: 8px 12px;
    margin: 0;
}

.play-detail__title {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 44px;
    color: var(--yellow);
    white-space: normal;
    margin: 26px 0 0 0;
    padding: 0;
}

.play-detail__text {
    margin-top: 12px;
    font-size: 18px;
    color: rgb(214, 220, 226);
}

.play-detail__facts {
    margin-top: 22px;
    padding: 14px 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(150, 170, 190, 0.18);
}

.fact-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
}

.fact-row__label {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--text-dim);
    width: 186px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
}

.fact-row__value {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 17px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.play-detail__note {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Regular.ttf");
    font-size: 15px;
    color: rgb(169, 180, 191);
    white-space: normal;
    margin: 18px 0 0 0;
    padding: 0;
}

.play-detail__spacer {
    flex-grow: 1;
}

.play-detail__status {
    margin-bottom: 12px;
}

.play-detail__button {
    height: 64px;
}

.play-detail__button > .da-btn__label {
    font-size: 22px;
}

/* Les salons */

.lobbies-panel {
    margin-bottom: 18px;
    padding: 26px 30px;
}

.lobbies-panel--last {
    margin-bottom: 0;
}

.lobbies-text {
    margin-bottom: 18px;
}

.join-row {
    flex-direction: row;
    align-items: center;
}

.join-code-field {
    width: 360px;
    height: 58px;
    margin-right: 16px;
}

.join-code-field > .unity-base-text-field__input {
    font-size: 30px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    color: var(--yellow);
}

.join-button {
    width: 220px;
    height: 58px;
}

.lan-split {
    flex-direction: row;
}

.lan-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 28px;
}

.lan-column--last {
    margin-right: 0;
}

.lan-label {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 0 0 8px 0;
    padding: 0;
}

.lan-address-row {
    flex-direction: row;
}

.lan-ip-field {
    flex-grow: 1;
    margin-right: 10px;
}

.lan-port-field {
    width: 110px;
}

.lan-button {
    margin-top: 12px;
    height: 46px;
}

.lan-note {
    margin-top: 10px;
}

/* ================= Salon =================
   Depuis le 2026-11-02, le gabarit partagé avec le salon de l'arène : Shared/SalonView.uxml et .uss. */

/* ================= Personnalisation ================= */

.custom-body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 20px;
}

.side-list {
    width: 330px;
}

.side-btn {
    height: 76px;
    margin-bottom: 12px;
    padding: 0 20px 0 22px;
    justify-content: flex-start;
}

.side-btn > .slant-bg {
    --fill-color: rgba(12, 17, 23, 0.9);
    --edge-color: rgba(150, 170, 190, 0.3);
    --cut-tl: 0;
    --cut-br: 16;
}

.side-btn > .side-btn__icon {
    width: 30px;
    height: 30px;
    margin-right: 20px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text);
}

.side-btn:hover > .side-btn__icon {
    -unity-background-image-tint-color: var(--yellow);
}

.side-btn__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.side-btn__title {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    -unity-text-align: middle-left;
    font-size: 19px;
    letter-spacing: 1px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.side-btn__subtitle {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    -unity-text-align: middle-left;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 3px 0 0 0;
    padding: 0;
}

.side-btn:hover > .side-btn__text > .side-btn__title {
    color: var(--yellow);
}

.side-btn__lock {
    width: 16px;
    height: 16px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-faint);
    background-image: url("project://database/Assets/_ProjectUI/Icons/lock.svg");
}

.side-btn--active > .slant-bg,
.side-btn--active:hover > .slant-bg {
    --fill-color: rgb(244, 190, 28);
    --edge-width: 0;
}

.side-btn--active > .side-btn__icon,
.side-btn--active:hover > .side-btn__icon {
    -unity-background-image-tint-color: var(--on-yellow);
}

.side-btn--active > .side-btn__text > .side-btn__title,
.side-btn--active:hover > .side-btn__text > .side-btn__title {
    color: var(--on-yellow);
}

.side-btn--active > .side-btn__text > .side-btn__subtitle {
    color: rgba(18, 22, 28, 0.75);
}

/* L'arsenal de l'armurerie (2026-10-26) : les douze armes, trois sous le nom de chaque famille. */
.weapon-family {
    margin-bottom: 14px;
}

.weapon-family__title {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    -unity-text-align: middle-left;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--text-dim);
    margin: 0 0 6px 2px;
    padding: 0;
}

.weapon-family__row {
    flex-direction: row;
}

.weapon-tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 86px;
    margin: 0 6px 0 0;
    padding: 6px 4px 4px 4px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.weapon-tile > .slant-bg {
    --fill-color: rgba(12, 17, 23, 0.9);
    --edge-color: rgba(150, 170, 190, 0.3);
    --cut-tl: 0;
    --cut-br: 12;
}

.weapon-tile__thumb {
    width: 96px;
    height: 48px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.weapon-tile__code {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    -unity-text-align: middle-center;
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--text);
    margin: 4px 0 0 0;
    padding: 0;
}

.weapon-tile:hover > .weapon-tile__code {
    color: var(--yellow);
}

.weapon-tile--active > .slant-bg,
.weapon-tile--active:hover > .slant-bg {
    --fill-color: rgb(244, 190, 28);
    --edge-width: 0;
}

.weapon-tile--active > .weapon-tile__code,
.weapon-tile--active:hover > .weapon-tile__code {
    color: var(--on-yellow);
}

.side-btn:disabled > .side-btn__text > .side-btn__title {
    color: var(--text-faint);
}

.side-btn:disabled > .side-btn__icon {
    -unity-background-image-tint-color: var(--text-faint);
}

.custom-stage {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 22px;
}

.custom-stage__view {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.custom-stage__hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Medium.ttf");
    font-size: 13px;
    color: var(--text-faint);
    -unity-text-align: middle-center;
}

.custom-stage__hint--top {
    top: 4px;
    bottom: auto;
}

.custom-side {
    width: 490px;
    padding: 22px 24px;
}

.custom-side__spacer {
    flex-grow: 1;
}

/* La grille du robot */

.robot-grid {
    margin-top: 4px;
}

.grid-row {
    flex-direction: row;
    margin-bottom: 12px;
}

.robot-tile {
    flex-grow: 1;
    flex-basis: 0;
    height: 176px;
    margin: 0 12px 0 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(14, 19, 25);
    justify-content: flex-end;
    overflow: hidden;
}

.robot-tile--row-end {
    margin-right: 0;
}

.robot-tile--placeholder {
    background-color: rgba(0, 0, 0, 0);
}

.robot-tile__art {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.robot-tile__name {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    margin: 0 0 6px 0;
    padding: 0;
}

.robot-tile--selected > .robot-tile__name {
    color: var(--yellow);
}

.robot-tile__check {
    position: absolute;
    right: 8px;
    top: 8px;
    width: 22px;
    height: 22px;
    background-color: var(--yellow);
    align-items: center;
    justify-content: center;
}

.robot-tile__check-icon {
    width: 14px;
    height: 14px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--on-yellow);
    background-image: url("project://database/Assets/_ProjectUI/Icons/check.svg");
}

.robot-tile__edge {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --edge-color: rgba(150, 170, 190, 0.26);
    --edge-width: 1;
}

.robot-tile:hover > .robot-tile__edge {
    --edge-color: rgba(244, 190, 28, 0.6);
}

.robot-tile--selected > .robot-tile__edge,
.robot-tile--selected:hover > .robot-tile__edge {
    --edge-color: rgb(244, 190, 28);
    --edge-width: 2;
    --bracket-color: rgb(244, 190, 28);
    --bracket-size: 16;
    --bracket-width: 3;
}

.robot-info {
    padding: 2px 0 2px 16px;
    border-left-width: 3px;
    border-color: var(--yellow);
}

.robot-info__name {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 0;
    padding: 0;
}

.robot-info__title {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 28px;
    color: var(--text);
    margin: 4px 0 0 0;
    padding: 0;
}

.robot-info__text {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Regular.ttf");
    font-size: 14px;
    color: var(--text-dim);
    white-space: normal;
    margin: 6px 0 0 0;
    padding: 0;
}

/* Les armes : la liste, l'arme, ses emplacements */

.weapon-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

.slot-row {
    flex-direction: row;
    justify-content: center;
}

.slot-btn {
    width: 116px;
    height: 112px;
    margin: 0 5px;
    padding: 12px 6px 10px 6px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(12, 17, 23, 0.92);
    align-items: center;
    justify-content: flex-start;
}

.slot-btn--group-start {
    margin-left: 26px;
}

.slot-btn__icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text);
}

.slot-btn__label {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 13px;
    color: var(--text);
    margin: 10px 0 0 0;
    padding: 0;
}

.slot-btn__value {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 11px;
    color: var(--yellow);
    margin: 4px 0 0 0;
    padding: 0;
}

.slot-btn__edge {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --edge-color: rgba(150, 170, 190, 0.32);
    --edge-width: 1;
}

.slot-btn:hover > .slot-btn__edge {
    --edge-color: rgba(244, 190, 28, 0.7);
}

.slot-btn--open > .slot-btn__edge,
.slot-btn--open:hover > .slot-btn__edge {
    --edge-color: rgb(244, 190, 28);
    --edge-width: 2;
    --bracket-color: rgb(244, 190, 28);
    --bracket-size: 14;
    --bracket-width: 3;
}

.slot-btn--open > .slot-btn__icon {
    -unity-background-image-tint-color: var(--yellow);
}

.slot-btn:disabled {
    opacity: 1;
}

.slot-btn:disabled > .slot-btn__icon {
    -unity-background-image-tint-color: rgba(143, 155, 168, 0.35);
}

.slot-btn:disabled > .slot-btn__label,
.slot-btn:disabled > .slot-btn__value {
    color: var(--text-faint);
}

.slot-strip {
    align-self: stretch;
    margin: 0 0 14px 0;
    padding: 14px 16px 16px 16px;
    --fill-color: rgba(10, 14, 19, 0.95);
    --edge-color: rgba(150, 170, 190, 0.3);
    --edge-width: 1;
    --cut-tr: 14;
    --cut-bl: 14;
}

.slot-strip__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.slot-strip__title {
    margin: 0 14px 0 0;
    color: var(--yellow);
}

.slot-strip__row {
    flex-direction: row;
    align-items: center;
}

.slot-strip__scroll {
    flex-grow: 1;
    flex-basis: 0;
}

.slot-strip__scroll .unity-scroll-view__content-container {
    flex-direction: row;
}

.strip-arrow {
    width: 34px;
    height: 120px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.strip-arrow:hover {
    background-color: rgba(244, 190, 28, 0.12);
}

.strip-arrow__icon {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--yellow);
}

.strip-arrow:disabled {
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
}

.strip-arrow:disabled > .strip-arrow__icon {
    -unity-background-image-tint-color: rgba(143, 155, 168, 0.2);
}

.choice-card {
    width: 168px;
    height: 128px;
    margin: 0 10px 0 0;
    padding: 0 10px 10px 10px;
    border-width: 0;
    border-radius: 0;
    background-color: rgb(16, 22, 29);
    justify-content: flex-end;
    flex-shrink: 0;
}

/* Un viseur se montre tel qu'on le voit en visée : une image plus grande, pour lire son réticule. */
.choice-card--sight {
    width: 208px;
    height: 150px;
}

.choice-card__art {
    position: absolute;
    left: 6px;
    top: 6px;
    right: 6px;
    bottom: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.choice-card__code {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 48px;
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 22px;
    color: rgba(232, 236, 240, 0.85);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.choice-card__title {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    -unity-text-align: middle-left;
    font-size: 13px;
    color: var(--text);
    margin: 0;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.choice-card__effect {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Regular.ttf");
    -unity-text-align: middle-left;
    font-size: 11px;
    color: var(--text-dim);
    margin: 2px 0 0 0;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.choice-card__tag {
    position: absolute;
    left: 8px;
    top: 8px;
    padding: 2px 6px;
    background-color: var(--yellow);
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Black.ttf");
    font-size: 10px;
    color: var(--on-yellow);
    display: none;
}

.choice-card--equipped > .choice-card__tag {
    display: flex;
}

.choice-card__edge {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --edge-color: rgba(150, 170, 190, 0.26);
    --edge-width: 1;
}

.choice-card:hover > .choice-card__edge,
.choice-card--previewed > .choice-card__edge {
    --edge-color: rgba(244, 190, 28, 0.75);
}

.choice-card--equipped > .choice-card__edge,
.choice-card--equipped:hover > .choice-card__edge {
    --edge-color: rgb(244, 190, 28);
    --edge-width: 2;
}

/* La fiche de l'arme */

.weapon-head {
    padding-left: 14px;
    border-left-width: 4px;
    border-color: var(--yellow);
}

.weapon-head__model {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-BlackItalic.ttf");
    font-size: 34px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.weapon-head__class {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 14px;
    letter-spacing: 1.5px;
    color: var(--yellow);
    margin: 2px 0 0 0;
    padding: 0;
}

.weapon-description {
    margin-top: 12px;
    font-size: 14px;
}

.weapon-stats-head {
    flex-direction: row;
    align-items: center;
    margin-top: 18px;
    margin-bottom: 4px;
}

.weapon-stats-title {
    margin: 0;
    flex-grow: 1;
}

.weapon-stats-legend {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--yellow);
    margin: 0;
    padding: 0;
}

.stat-row {
    margin-top: 9px;
}

.stat-row__head {
    flex-direction: row;
    align-items: center;
}

.stat-row__label {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--text);
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.stat-row__value {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 14px;
    color: var(--text);
    margin: 0;
    padding: 0;
}

.stat-row__value--gain {
    color: var(--green);
}

.stat-row__value--loss {
    color: var(--red);
}

.stat-row__track {
    height: 5px;
    margin-top: 5px;
    background-color: rgba(255, 255, 255, 0.12);
}

.stat-row__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(236, 239, 242);
}

.stat-row__delta {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
}

.stat-row__delta--gain {
    background-color: var(--green);
}

.stat-row__delta--loss {
    background-color: var(--red);
}

.info-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 16px;
}

.info-cell {
    width: 50%;
    margin-bottom: 10px;
}

.info-cell__caption {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin: 0;
    padding: 0;
}

.info-cell__value {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/Roboto-Bold.ttf");
    font-size: 14px;
    color: var(--text);
    margin: 2px 0 0 0;
    padding: 0;
    white-space: normal;
}

.ai-box {
    height: 112px;
    flex-shrink: 0;
    padding: 10px 12px;
    border-width: 1px;
    border-color: rgba(244, 190, 28, 0.35);
    background-color: rgba(6, 9, 13, 0.75);
}

.ai-box__header {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 11px;
    color: var(--yellow);
    margin: 0 0 6px 0;
    padding: 0;
}

.ai-box__text {
    -unity-font-definition: url("project://database/Assets/_ProjectUI/Fonts/RobotoMono-Bold.ttf");
    font-size: 12px;
    color: rgb(205, 211, 218);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.footer-hints {
    flex-direction: row;
    align-items: center;
    margin-left: 20px;
}

/* ================= Options ================= */

.options-screen > .options-instance {
    flex-grow: 1;
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    margin-top: 6px;
}

.options-note {
    margin-left: 20px;
}

/* ================= Fenêtres ================= */

.modal-back {
    align-self: center;
}
